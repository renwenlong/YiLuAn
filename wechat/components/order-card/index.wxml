<view class="order-card" bindtap="onTap">
  <view class="order-header">
    <text class="order-service">{{serviceLabel}}</text>
    <view class="order-status" style="background: {{statusInfo.color}};">
      <text class="status-text">{{statusInfo.label}}</text>
    </view>
  </view>
  <view class="order-body">
    <view class="order-row">
      <text class="order-label">{{t['order.rowHospital']}}</text>
      <text class="order-value">{{order.hospital_name}}</text>
    </view>
    <view class="order-row">
      <text class="order-label">{{t['order.rowTime']}}</text>
      <text class="order-value">{{order.appointment_date}} {{order.appointment_time}}</text>
    </view>
    <view class="order-row" wx:if="{{order.patient_name}}">
      <text class="order-label">{{t['order.rowPatient']}}</text>
      <text class="order-value">{{order.patient_name}}</text>
    </view>
    <view class="order-row" wx:if="{{familyMemberText}}">
      <text class="order-label">{{t['order.rowActualPatient']}}</text>
      <text class="order-value">{{familyMemberText}}</text>
    </view>
    <view class="order-desc" wx:if="{{order.description}}">
      <text class="order-desc-text">{{order.description}}</text>
    </view>
  </view>
  <view class="order-footer">
    <text class="order-price">{{priceText}}</text>
    <text class="pay-hint" wx:if="{{order.status === 'created' && order.payment_status === 'unpaid'}}">{{t['order.payHint']}}</text>
    <text class="review-hint" wx:if="{{order.status === 'completed'}}">{{t['order.reviewHint']}}</text>
    <text class="reviewed-hint" wx:if="{{order.status === 'reviewed'}}">{{t['order.reviewedHint']}}</text>
  </view>
</view>
