<view class="tab-bar">
  <view class="tab-item {{active === 'home' ? 'active' : ''}}" data-page="home" bindtap="onTap">
    <text class="tab-label">{{t['tabBar.home']}}</text>
  </view>
  <view class="tab-item {{active === 'orders' ? 'active' : ''}}" data-page="orders" bindtap="onTap">
    <text class="tab-label">{{t['tabBar.orders']}}</text>
  </view>
  <view class="tab-item {{active === 'chat' ? 'active' : ''}}" data-page="chat" bindtap="onTap">
    <text class="tab-label">{{t['tabBar.chat']}}</text>
  </view>
  <view class="tab-item {{active === 'profile' ? 'active' : ''}}" data-page="profile" bindtap="onTap">
    <text class="tab-label">{{t['tabBar.profile']}}</text>
  </view>
</view>
<view class="tab-bar-spacer"></view>
