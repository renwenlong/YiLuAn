/* components/cert-card — S3-DEV-003-TRUST-UI-WX */

.cert-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin: 16rpx 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.cert-card__header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.cert-card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.cert-card__badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.cert-card__badge--verified {
  background: #e6f7ee;
  color: #0a8043;
}

.cert-card__badge--pending {
  background: #fff7e6;
  color: #b25e09;
}

.cert-card__badge--unverified {
  background: #f5f5f5;
  color: #8a8a8a;
}

.cert-card__body {
  display: flex;
  flex-direction: column;
}

.cert-card__row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin: 12rpx 0;
}

.cert-card__label {
  width: 130rpx;
  font-size: 26rpx;
  color: #8a8a8a;
  flex-shrink: 0;
}

.cert-card__value {
  flex: 1;
  font-size: 26rpx;
  color: #1a1a1a;
  word-break: break-all;
}

.cert-card__tags {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
}

.cert-card__tag {
  display: inline-block;
  margin: 0 12rpx 8rpx 0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #f0f4ff;
  color: #2c4a99;
  font-size: 22rpx;
}

.cert-card__hint {
  margin-top: 8rpx;
  padding: 12rpx;
  background: #fafafa;
  color: #8a8a8a;
  font-size: 24rpx;
  border-radius: 8rpx;
}
