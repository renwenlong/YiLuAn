<view class="login-page">
  <view class="login-content">
    <view class="logo-section">
      <view class="logo-placeholder">
        <text class="logo-text">{{t['login.appName']}}</text>
      </view>
      <text class="app-description">{{t['login.appDesc']}}</text>
    </view>

    <view class="action-section">
      <!-- 微信登录 -->
      <button
        wx:if="{{!showPhoneLogin}}"
        class="login-btn wechat-btn"
        loading="{{loading}}"
        disabled="{{loading}}"
        bindtap="onLogin"
      >
        {{t['login.wechatLogin']}}
      </button>

      <!-- 手机号登录 -->
      <view wx:if="{{showPhoneLogin}}" class="phone-login-section">
        <view class="phone-form">
          <view class="form-group">
            <view class="phone-row">
              <input
                class="form-input phone-input"
                type="number"
                maxlength="11"
                placeholder="{{t['login.inputPhone']}}"
                value="{{phone}}"
                bindinput="onPhoneInput"
              />
              <button
                class="otp-btn"
                disabled="{{sendingOTP || countdown > 0}}"
                bindtap="onSendOTP"
              >
                {{countdown > 0 ? countdown + 's' : t['login.getCode']}}
              </button>
            </view>
          </view>
          <view class="form-group">
            <input
              class="form-input"
              type="number"
              maxlength="6"
              placeholder="{{t['login.inputCode']}}"
              value="{{code}}"
              bindinput="onCodeInput"
            />
          </view>
        </view>
        <button
          class="login-btn phone-submit-btn"
          loading="{{loading}}"
          disabled="{{loading}}"
          bindtap="onPhoneLogin"
        >
          {{t['login.submit']}}
        </button>
      </view>

      <!-- 切换登录方式 -->
      <view class="switch-login" bindtap="onSwitchLoginMode">
        <text class="switch-login-text">{{showPhoneLogin ? t['login.wechatLogin'] : t['login.phoneLogin']}}</text>
      </view>

      <!-- 协议勾选 -->
      <view class="agreement-section">
        <view class="agreement-checkbox" bindtap="onToggleAgreement">
          <view class="checkbox-icon {{agreed ? 'checked' : ''}}">
            <text wx:if="{{agreed}}" class="check-mark">✓</text>
          </view>
          <view class="agreement-text">
            <text>{{t['login.agreementPre']}}</text>
            <text class="agreement-link" catchtap="onOpenTerms">{{t['login.userAgreement']}}</text>
            <text>{{t['login.and']}}</text>
            <text class="agreement-link" catchtap="onOpenPrivacy">{{t['login.privacyPolicy']}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
