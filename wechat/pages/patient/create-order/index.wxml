<!--
  S2-INT-004 prelude · U-1 折叠式分步下单
  契约真源：docs/design/wireframes/U1-folding-stepper/README.md
  状态机由 utils/stepperState.js 计算，巨字号 token 由 utils/fontScale.js 提供。
  与 iOS 端逐字符互锁（AC#13 / AC#25）。
-->
<view class="page-container {{hugeFont ? 'huge' : ''}}"
      style="--body-font:{{fontTokens.bodyFont}}px;--meta-font:{{fontTokens.metaFont}}px;--primary-btn-h:{{fontTokens.primaryBtnH}}px;--label-mt:{{fontTokens.labelMarginTop}}px;--label-mb:{{fontTokens.labelMarginBottom}}px;--step-num:{{fontTokens.stepNum}}px;">

  <!-- 巨字号 toggle（PRD §F5） -->
  <view class="huge-font-toggle">
    <text class="huge-font-label">巨字号</text>
    <switch checked="{{hugeFont}}" bindchange="onToggleHugeFont" color="#1e88e5" />
  </view>

  <!-- ① 服务类型 -->
  <view class="step-section state-{{stepStates[0]}}" data-step="1" bindtap="onStepTap">
    <view class="step-head">
      <view class="step-num">{{stepStates[0] === 'done' ? '✓' : '1'}}</view>
      <text class="step-title">{{stepTitles[0]}}</text>
      <text class="step-summary" wx:if="{{stepStates[0] === 'done'}}">{{summaryService}}</text>
      <text class="step-placeholder" wx:elif="{{stepStates[0] === 'collapsed'}}">未选择</text>
    </view>
    <view class="step-body" wx:if="{{stepStates[0] === 'active'}}" catchtap="">
      <view class="service-option {{serviceType === item.code ? 'active' : ''}}"
            wx:for="{{serviceTypes}}"
            wx:key="code"
            data-code="{{item.code}}"
            data-name="{{item.name}}"
            data-price="{{item.price}}"
            bindtap="onSelectServiceType">
        <text class="service-name">{{item.name}}</text>
        <text class="service-price">¥{{item.price}}</text>
        <text class="service-check" wx:if="{{serviceType === item.code}}">✓</text>
      </view>
      <button class="step-next-btn" bindtap="onNextStep" disabled="{{!serviceType}}">下一步</button>
    </view>
  </view>

  <!-- ② 医院（科室可选） -->
  <view class="step-section state-{{stepStates[1]}}" data-step="2" bindtap="onStepTap">
    <view class="step-head">
      <view class="step-num">{{stepStates[1] === 'done' ? '✓' : '2'}}</view>
      <text class="step-title">{{stepTitles[1]}}</text>
      <text class="step-summary" wx:if="{{stepStates[1] === 'done'}}">{{summaryHospital}}</text>
      <text class="step-placeholder" wx:elif="{{stepStates[1] === 'collapsed'}}">未选择</text>
    </view>
    <view class="step-body" wx:if="{{stepStates[1] === 'active'}}" catchtap="">
      <view class="info-card" wx:if="{{hospitalName}}">
        <text class="info-name">{{hospitalName}}</text>
        <text class="change-btn" bindtap="onChangeHospital">更换</text>
      </view>
      <button class="select-hospital-btn" wx:else bindtap="onChangeHospital">选择医院</button>
      <picker wx:if="{{hospitalId && departmentList.length > 0}}"
              mode="selector"
              range="{{departmentList}}"
              value="{{departmentIndex}}"
              bindchange="onDepartmentChange">
        <view class="picker-row">
          <text class="picker-label">科室（可选）</text>
          <text class="picker-value">{{department || '不选择科室'}}</text>
        </view>
      </picker>
      <button class="step-next-btn" bindtap="onNextStep" disabled="{{!hospitalId}}">下一步</button>
    </view>
  </view>

  <!-- ③ 日期 -->
  <view class="step-section state-{{stepStates[2]}}" data-step="3" bindtap="onStepTap">
    <view class="step-head">
      <view class="step-num">{{stepStates[2] === 'done' ? '✓' : '3'}}</view>
      <text class="step-title">{{stepTitles[2]}}</text>
      <text class="step-summary" wx:if="{{stepStates[2] === 'done'}}">{{summaryDate}}</text>
      <text class="step-placeholder" wx:elif="{{stepStates[2] === 'collapsed'}}">未选择</text>
    </view>
    <view class="step-body" wx:if="{{stepStates[2] === 'active'}}" catchtap="">
      <picker mode="date" value="{{date}}" bindchange="onDateChange">
        <view class="picker-row">
          <text class="picker-label">日期</text>
          <text class="picker-value">{{date || '请选择日期'}}</text>
        </view>
      </picker>
      <view class="period-row">
        <text class="picker-label">时段</text>
        <view class="period-options">
          <view class="period-option {{period === '上午' ? 'active' : ''}}" data-period="上午" bindtap="onSelectPeriod">上午</view>
          <view class="period-option {{period === '下午' ? 'active' : ''}}" data-period="下午" bindtap="onSelectPeriod">下午</view>
        </view>
      </view>
      <button class="step-next-btn" bindtap="onNextStep" disabled="{{!date || !period}}">下一步</button>
    </view>
  </view>

  <!-- ④ 患者&陪诊师 -->
  <view class="step-section state-{{stepStates[3]}}" data-step="4" bindtap="onStepTap">
    <view class="step-head">
      <view class="step-num">{{stepStates[3] === 'done' ? '✓' : '4'}}</view>
      <text class="step-title">{{stepTitles[3]}}</text>
      <text class="step-summary" wx:if="{{stepStates[3] === 'done'}}">{{summaryPatient}}</text>
      <text class="step-placeholder" wx:elif="{{stepStates[3] === 'collapsed'}}">未选择</text>
    </view>
    <view class="step-body" wx:if="{{stepStates[3] === 'active'}}" catchtap="">
      <!-- 给谁下单 -->
      <view class="sub-section">
        <view class="sub-header">
          <text class="sub-label">给谁下单</text>
          <text class="change-btn" bindtap="onManageFamilyMembers">管理家人</text>
        </view>
        <picker mode="selector" range="{{familyMemberOptions}}" value="{{familyMemberIndex}}" bindchange="onFamilyMemberChange">
          <view class="picker-value">{{familyMemberOptions[familyMemberIndex]}}</view>
        </picker>
      </view>

      <!-- 陪诊师 -->
      <view class="sub-section">
        <view class="sub-header">
          <text class="sub-label">指定陪诊师</text>
          <text class="change-btn" bindtap="onChangeCompanion">重新选择</text>
        </view>
        <view class="companion-info-card" wx:if="{{companion}}">
          <view class="avatar-placeholder">
            <text class="avatar-text">{{companion.name[0]}}</text>
          </view>
          <view class="companion-detail">
            <text class="companion-name">{{companion.name}}</text>
            <view class="companion-meta">
              <text class="meta-item">★ {{companion.rating}}</text>
              <text class="meta-item">已完成 {{companion.completed_orders}} 单</text>
            </view>
          </view>
        </view>
        <view class="info-card placeholder" wx:else>
          <text class="info-name placeholder-text">加载中...</text>
        </view>
      </view>

      <!-- 备注 -->
      <view class="sub-section">
        <text class="sub-label">备注（可选）</text>
        <textarea class="form-textarea" placeholder="请描述您的需求，如症状等" value="{{notes}}" bindinput="onNotesInput" maxlength="200" />
      </view>
    </view>
  </view>

  <!-- 提交按钮 sticky 底部 -->
  <view class="submit-area">
    <button class="submit-btn" bindtap="onSubmit" loading="{{loading}}" disabled="{{!canSubmit}}">
      确认下单{{serviceType ? ' ¥' + servicePrice : ''}}
    </button>
  </view>
</view>

<!-- 陪诊师选择弹窗（保留原结构） -->
<view class="modal-mask" wx:if="{{showCompanionPicker}}" bindtap="onCloseCompanionPicker">
  <view class="modal-content" catchtap>
    <view class="modal-header">
      <text class="modal-title">选择陪诊师</text>
      <text class="modal-close" bindtap="onCloseCompanionPicker">✕</text>
    </view>
    <view class="modal-body">
      <view class="loading-hint" wx:if="{{loadingCompanions}}">
        <text>加载中...</text>
      </view>
      <view
        class="companion-option {{companionId === item.id ? 'active' : ''}}"
        wx:for="{{companionList}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onSelectCompanion"
      >
        <view class="avatar-placeholder small">
          <text class="avatar-text">{{item.name[0]}}</text>
        </view>
        <view class="companion-option-info">
          <view class="companion-option-header">
            <text class="companion-option-name">{{item.name}}</text>
            <text class="verified-badge" wx:if="{{item.verified}}">已认证</text>
          </view>
          <view class="companion-option-stats">
            <text class="stat-item">★ {{item.rating}}</text>
            <text class="stat-item">已完成 {{item.completed_orders}} 单</text>
          </view>
          <text class="companion-option-bio" wx:if="{{item.bio}}">{{item.bio}}</text>
          <view class="companion-option-tags" wx:if="{{item.service_areas.length > 0}}">
            <text class="area-tag" wx:for="{{item.service_areas}}" wx:for-item="area" wx:key="*this">{{area}}</text>
          </view>
        </view>
        <text class="companion-option-check" wx:if="{{companionId === item.id}}">✓</text>
      </view>
      <view class="empty-hint" wx:if="{{!loadingCompanions && companionList.length === 0}}">
        <text>暂无匹配的陪诊师</text>
      </view>
    </view>
  </view>
</view>
