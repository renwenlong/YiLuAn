<!-- AI-9: 加载骨架屏（只在首次加载且无 order 时展示） -->
<view class="page-container" wx:if="{{loading && !order}}">
  <view class="skeleton-card skeleton-status"></view>
  <view class="skeleton-card">
    <view class="skeleton-line skeleton-line-title"></view>
    <view class="skeleton-line"></view>
    <view class="skeleton-line"></view>
    <view class="skeleton-line skeleton-line-short"></view>
  </view>
  <view class="skeleton-card">
    <view class="skeleton-line skeleton-line-title"></view>
    <view class="skeleton-line"></view>
    <view class="skeleton-line skeleton-line-short"></view>
  </view>
</view>

<!-- AI-9: 后续刷新仍走轻量 overlay（不再白屏，order 仍渲染） -->
<loading-overlay wx:if="{{loading && order}}" />

<view class="page-container" wx:if="{{order}}">
  <!-- [F-03] Emergency button (in_progress only) -->
  <view
    class="emergency-fab tap-target"
    wx:if="{{order.status === 'in_progress'}}"
    bindtap="onEmergencyTap"
  >
    <text class="emergency-icon">⚠️</text>
    <text class="emergency-label">{{t['orderDetail.emergencyCall']}}</text>
  </view>

  <!-- Emergency modal -->
  <view class="em-mask" wx:if="{{showEmergency}}" bindtap="onEmergencyClose" />
  <view class="em-modal" wx:if="{{showEmergency}}">
    <view class="em-title">{{t['orderDetail.emergencyCall']}}</view>
    <view class="em-hint">{{t['orderDetail.selectContact']}}</view>
    <view class="em-list">
      <view
        class="em-item tap-target"
        wx:for="{{emergencyContacts}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onCallContact"
      >
        <view class="em-item-name">{{item.name}} <text class="em-rel">{{item.relationship}}</text></view>
        <view class="em-item-phone">{{item.phone}}</view>
      </view>
      <view class="em-empty" wx:if="{{emergencyContacts.length === 0}}">
        <text>{{t['orderDetail.noEmergencyContact']}}</text>
        <text class="em-link tap-target" bindtap="onManageContacts">{{t['orderDetail.goAdd']}}</text>
      </view>
      <view class="em-item em-hotline tap-target" bindtap="onCallHotline">
        <view class="em-item-name">{{t['orderDetail.platformHotline']}}</view>
        <view class="em-item-phone">{{emergencyHotline || t['common.loading']}}</view>
      </view>
    </view>
    <button class="em-cancel" bindtap="onEmergencyClose">{{t['common.cancel']}}</button>
  </view>
  <!-- Status Header -->
  <view class="status-header status-{{order.status}}">
    <view class="status-header-decor"></view>
    <text class="status-text">{{statusLabelText || order.status}}</text>
    <text class="status-subtitle" wx:if="{{order.status === 'created' && order.payment_status === 'unpaid'}}">{{t['orderDetail.subPayNow']}}</text>
    <text class="status-subtitle" wx:elif="{{order.status === 'created' && countdown}}">{{t['orderDetail.subAutoCancel']}} <text class="countdown-text {{countdownUrgent ? 'countdown-urgent' : ''}}">{{countdown}}</text></text>
    <text class="status-subtitle" wx:elif="{{order.status === 'created'}}">{{t['orderDetail.subWaitAccept']}}</text>
    <text class="status-subtitle" wx:elif="{{order.status === 'accepted'}}">{{t['orderDetail.subAccepted']}}</text>
    <text class="status-subtitle" wx:elif="{{order.status === 'in_progress'}}">{{t['orderDetail.subInProgress']}}</text>
    <text class="status-subtitle" wx:elif="{{order.status === 'completed'}}">{{t['orderDetail.subCompleted']}}</text>
    <text class="status-subtitle" wx:elif="{{order.status === 'rejected_by_companion'}}">{{t['orderDetail.subRejected']}}</text>
    <text class="status-subtitle" wx:elif="{{order.status === 'expired'}}">{{t['orderDetail.subExpired']}}</text>
    <text class="status-subtitle" wx:elif="{{order.status === 'cancelled_by_patient' || order.status === 'cancelled_by_companion'}}">{{t['orderDetail.subCancelled']}}</text>
  </view>

  <!-- Order Info -->
  <view class="detail-section">
    <view class="section-title">{{t['orderDetail.orderInfo']}}</view>
    <view class="info-row">
      <text class="info-label">{{t['orderDetail.orderNumber']}}</text>
      <text class="info-value">{{order.order_number}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">{{t['orderDetail.serviceTypeLabel']}}</text>
      <text class="info-value">{{serviceLabel}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">{{t['orderDetail.hospitalLabel']}}</text>
      <text class="info-value">{{order.hospital_name}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">{{t['orderDetail.appointmentTime']}}</text>
      <text class="info-value">{{order.appointment_date}} {{order.appointment_time}}</text>
    </view>
    <view class="info-row" wx:if="{{order.formattedPrice}}">
      <text class="info-label">{{t['orderDetail.feeLabel']}}</text>
      <text class="info-value price">{{order.formattedPrice}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">{{t['orderDetail.paymentStatusLabel']}}</text>
      <text class="info-value payment-{{paymentStatusClass}}">{{paymentStatusLabel}}</text>
    </view>
    <view class="info-row" wx:if="{{order.description}}">
      <text class="info-label">{{t['orderDetail.notesLabel']}}</text>
      <text class="info-value">{{order.description}}</text>
    </view>
  </view>

  <!-- Companion Info -->
  <view class="detail-section" wx:if="{{order.companion_name}}">
    <view class="section-title">{{t['orderDetail.companionInfo']}}</view>
    <view class="info-row">
      <text class="info-label">{{t['orderDetail.companionLabel']}}</text>
      <text class="info-value">{{order.companion_name}}</text>
    </view>
  </view>

  <!-- S3-DEV-003-TRUST-UI-WX: 陪诊师资质信任卡 (cert-card)
       仅在 precheck-status 拉到 且 certStatus 非 null 时渲染.
       certStatus null 时隐藏, 不阻订单详情主流程. -->
  <view class="detail-section" wx:if="{{certStatus}}">
    <!-- S3-DEV-003-TRUST-UI-WX-POLLING-FALLBACK: WS 断时 30s 轮询 fallback 提示
         (跨端对齐 iOS PrecheckViewModel.isPollingFallback @Published).
         显示 "轮询中" + orange 颜色, 让用户感知网络不稳但 precheck 状态仍在更新.
         WS 重连成功后自动隐藏 (precheckWs 'authenticated' event 触发 stopPolling). -->
    <view wx:if="{{isPollingFallback}}" class="polling-fallback-indicator">
      <text class="polling-fallback-icon">⟳</text>
      <text class="polling-fallback-text">{{t['orderDetail.pollingFallback']}}</text>
    </view>
    <cert-card cert-status="{{certStatus}}" />
  </view>

  <!-- [F-05] 实际就诊人（代他人下单） -->
  <view class="detail-section" wx:if="{{order.family_member}}">
    <view class="section-title">{{t['orderDetail.actualPatient']}}</view>
    <view class="info-row">
      <text class="info-label">{{t['orderDetail.nameLabel']}}</text>
      <text class="info-value">{{order.family_member.name}}（{{familyRelationLabel}}）</text>
    </view>
    <view class="info-row" wx:if="{{order.family_member.phone}}">
      <text class="info-label">{{t['orderDetail.phoneLabel']}}</text>
      <text class="info-value">{{order.family_member.phone}}</text>
    </view>
  </view>

  <!-- Status Timeline -->
  <view class="detail-section">
    <view class="section-title">{{t['orderDetail.orderProgress']}}</view>
    <view class="timeline">
      <view class="timeline-item {{order.timeline && index <= order.timelineIndex ? 'active' : ''}}" wx:for="{{order.timeline}}" wx:key="time">
        <view class="timeline-dot"></view>
        <view class="timeline-content">
          <text class="timeline-title">{{item.title}}</text>
          <text class="timeline-time">{{item.time}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Review Section (if completed with review) -->
  <view class="detail-section" wx:if="{{order.review}}">
    <view class="section-title">{{t['orderDetail.reviewLabel']}}</view>
    <view class="review-card">
      <rating-stars value="{{order.review.rating}}" readonly="{{true}}" />
      <text class="review-content">{{order.review.content}}</text>
    </view>
  </view>

  <!-- Action Buttons (AI-9: actionLoading 锁，避免重复点击) -->
  <view class="action-bar">
    <!-- Created & unpaid: pay + cancel
         ADR-0047 §6.3 + S3-DEV-001-CONTRACT-UI:
         合同/保障条款 checkbox 默认 unchecked + 支付按钮 disabled until 勾选 -->
    <block wx:if="{{order.status === 'created' && order.payment_status === 'unpaid'}}">
      <!-- 合同勾选区 (order.contract_id 存在才显示; PR #207 OrderResponse 新字段) -->
      <view class="contract-acceptance" wx:if="{{order.contract_id}}">
        <view class="contract-checkbox-row" bindtap="onToggleContractAccept">
          <view class="contract-checkbox {{contractAccepted ? 'checked' : ''}}" aria-checked="{{contractAccepted}}" role="checkbox">
            <text wx:if="{{contractAccepted}}" class="contract-checkbox-tick">✓</text>
          </view>
          <view class="contract-checkbox-label">
            <text>{{t['orderDetail.agreePre']}}</text>
            <text class="contract-link" catchtap="onViewContract">{{t['orderDetail.contractLink']}}</text>
            <text wx:if="{{order.insurance_id}}">+</text>
            <text wx:if="{{order.insurance_id}}" class="contract-link" catchtap="onViewInsuranceTerms">{{t['orderDetail.insuranceLink']}}</text>
          </view>
        </view>
        <text wx:if="{{!contractAccepted}}" class="contract-hint">{{t['orderDetail.contractHint']}}</text>
      </view>
      <!-- 支付按钮: 有合同时必须勾选才解锁; 无合同时 (历史订单) 直接可点 -->
      <button class="btn-primary" bindtap="onPay" loading="{{actionLoading}}" disabled="{{actionLoading || (order.contract_id && !contractAccepted)}}">
        {{actionLoading ? t['orderDetail.processing'] : t['orderDetail.payNow'] + ' ' + order.formattedPrice}}
      </button>
      <button class="btn-danger" bindtap="onCancel" loading="{{actionLoading}}" disabled="{{actionLoading}}">
        {{actionLoading ? t['orderDetail.processing'] : t['orderDetail.cancelOrder']}}
      </button>
    </block>

    <!-- Created & paid: cancel only -->
    <block wx:if="{{order.status === 'created' && order.payment_status === 'paid'}}">
      <button class="btn-danger" bindtap="onCancel" loading="{{actionLoading}}" disabled="{{actionLoading}}">
        {{actionLoading ? t['orderDetail.processing'] : t['orderDetail.cancelOrder']}}
      </button>
    </block>

    <!-- Accepted: confirm-start + chat + cancel -->
    <block wx:if="{{order.status === 'accepted'}}">
      <button class="btn-primary" bindtap="onConfirmStart" loading="{{actionLoading}}" disabled="{{actionLoading}}">
        {{actionLoading ? t['orderDetail.processing'] : t['orderDetail.confirmStart']}}
      </button>
      <button class="btn-secondary" bindtap="onChat" disabled="{{actionLoading}}">{{t['orderDetail.contactCompanion']}}</button>
      <button class="btn-danger" bindtap="onCancel" loading="{{actionLoading}}" disabled="{{actionLoading}}">
        {{actionLoading ? t['orderDetail.processing'] : t['orderDetail.cancelOrder']}}
      </button>
    </block>
    <block wx:if="{{order.status === 'in_progress'}}">
      <button class="btn-primary" bindtap="onChat" disabled="{{actionLoading}}">{{t['orderDetail.contactCompanion']}}</button>
      <button class="btn-danger" bindtap="onCancelInProgress" loading="{{actionLoading}}" disabled="{{actionLoading}}">
        {{actionLoading ? t['orderDetail.processing'] : t['orderDetail.cancelOrder']}}
      </button>
    </block>

    <!-- Completed without review: can review -->
    <block wx:if="{{order.status === 'completed' && !order.review}}">
      <button class="btn-primary" bindtap="onReview" disabled="{{actionLoading}}">{{t['orderDetail.writeReview']}}</button>
      <button class="btn-secondary" bindtap="onChat" disabled="{{actionLoading}}">{{t['orderDetail.contactCompanion']}}</button>
    </block>

    <!-- [F-07] 复诊提醒：已完成/已评价订单可创建，与 iOS 对齐 -->
    <block wx:if="{{order.status === 'completed' || order.status === 'reviewed'}}">
      <button class="btn-secondary" bindtap="onCreateFollowup" disabled="{{actionLoading}}">{{t['orderDetail.createFollowup']}}</button>
    </block>

    <!-- Rejected / Expired: reorder -->
    <block wx:if="{{order.status === 'rejected_by_companion' || order.status === 'expired'}}">
      <button class="btn-primary" bindtap="onReorder">{{t['orderDetail.reorder']}}</button>
    </block>

    <!-- ANDROID-DEV-WX-SHARE-ENTRY: 家属分享入口。订单已有陪诊师/进度可分享时显示,
         对齐 iOS 发起端语义(createShare)。付款后 accepted/in_progress/completed/reviewed 态。 -->
    <block wx:if="{{order.status === 'accepted' || order.status === 'in_progress' || order.status === 'completed' || order.status === 'reviewed'}}">
      <button class="btn-secondary" bindtap="onShareToFamily" disabled="{{actionLoading}}">{{t['shareEntry.entryButton']}}</button>
    </block>
  </view>
</view>
