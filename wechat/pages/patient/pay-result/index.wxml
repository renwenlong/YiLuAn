<view class="result-page">
  <!-- Success -->
  <block wx:if="{{status === 'success'}}">
    <view class="icon-circle success-bg">
      <text class="icon-text">✓</text>
    </view>
    <text class="result-title">{{t['payResult.successTitle']}}</text>
    <text class="result-desc">{{t['payResult.successDesc']}}</text>
    <button class="btn-primary" bindtap="onViewOrder">{{t['payResult.viewOrder']}}</button>
    <button class="btn-secondary" bindtap="onGoHome">{{t['payResult.goHome']}}</button>
  </block>

  <!-- Fail -->
  <block wx:if="{{status === 'fail'}}">
    <view class="icon-circle fail-bg">
      <text class="icon-text">✗</text>
    </view>
    <text class="result-title">{{t['payResult.failTitle']}}</text>
    <text class="result-desc">{{errorMsg || t['payResult.failDesc']}}</text>
    <button class="btn-primary" bindtap="onRetry">{{t['payResult.retry']}}</button>
    <button class="btn-secondary" bindtap="onViewOrder">{{t['payResult.viewOrder']}}</button>
  </block>

  <!-- Cancel -->
  <block wx:if="{{status === 'cancel'}}">
    <view class="icon-circle cancel-bg">
      <text class="icon-text">!</text>
    </view>
    <text class="result-title">{{t['payResult.cancelTitle']}}</text>
    <text class="result-desc">{{t['payResult.cancelDesc']}}</text>
    <button class="btn-primary" bindtap="onRetry">{{t['payResult.retry']}}</button>
    <button class="btn-secondary" bindtap="onViewOrder">{{t['payResult.backToOrder']}}</button>
  </block>
</view>
