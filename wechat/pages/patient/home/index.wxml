<view class="patient-home">
  <network-banner />
  <!-- 定位 + 搜索医院 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">{{t['home.selectHospital']}}</text>
      <text class="section-clear" wx:if="{{selectedHospital}}" bindtap="onClearHospital">{{t['home.clearSelection']}}</text>
      <view class="location-bar" wx:else bindtap="onCityTap">
        <text class="location-icon">📍</text>
        <text class="location-city">{{cityDisplay}}</text>
      </view>
    </view>
    <!-- 未选中：搜索栏 + 完整列表 -->
    <block wx:if="{{!selectedHospital}}">
      <view class="search-bar">
        <input class="search-input" placeholder="{{t['home.searchHospital']}}" value="{{hospitalKeyword}}" bindinput="onHospitalSearch" confirm-type="search" />
      </view>
      <view class="hospital-list" wx:if="{{hospitals.length > 0}}">
        <view class="hospital-card" wx:for="{{hospitals}}" wx:key="id" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="onHospitalTap">
          <view class="hospital-info">
            <text class="hospital-name">{{item.name}}</text>
            <text class="hospital-meta">{{item.level}}{{item.level && item.district ? ' · ' : ''}}{{item.district}}</text>
          </view>
        </view>
      </view>
      <view class="empty-hint" wx:if="{{hospitals.length === 0 && city}}">
        <text class="empty-hint-icon">🏥</text>
        <text class="empty-hint-text">{{t['home.noHospitalFound']}}</text>
      </view>
    </block>
    <!-- 已选中：只展示选中的医院 -->
    <block wx:else>
      <view class="hospital-list">
        <view class="hospital-card active" data-id="{{selectedHospital.id}}" data-name="{{selectedHospital.name}}" bindtap="onHospitalTap">
          <view class="hospital-info">
            <text class="hospital-name">{{selectedHospital.name}}</text>
          </view>
          <text class="hospital-check">✓</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 选择服务 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">{{t['home.selectService']}}</text>
      <text class="section-hint" wx:if="{{!selectedService}}">{{t['home.tapSelectService']}}</text>
      <text class="section-clear" wx:if="{{selectedService}}" bindtap="onServiceTap" data-type="{{selectedService}}">{{t['home.clearFilter']}}</text>
    </view>
    <view class="service-grid">
      <service-card
        wx:for="{{serviceTypes}}"
        wx:key="key"
        type="{{item.key}}"
        active="{{selectedService === item.key}}"
        data-type="{{item.key}}"
        bindtap="onServiceTap"
      />
    </view>
  </view>

  <!-- 推荐陪诊师 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">{{selectedHospital ? matchedTitle : (selectedService ? t['home.matchedCompanions'] : t['home.recommendedCompanions'])}}</text>
    </view>

    <view class="companion-list" wx:if="{{companions.length > 0}}">
      <companion-card
        wx:for="{{companions}}"
        wx:key="id"
        companion="{{item}}"
        showBook="{{!!selectedService}}"
        data-id="{{item.id}}"
        bindtap="onCompanionTap"
        bindbook="onBookCompanion"
      />
    </view>

    <!-- 首次加载：骨架屏，仅在空列表 + loading 时显示 -->
    <skeleton-list wx:if="{{loadingCompanions && companions.length === 0}}" variant="companion" count="4" />

    <view class="empty-hint" wx:if="{{companions.length === 0 && !loadingCompanions}}">
      <text class="empty-hint-icon">👩‍⚕️</text>
      <text class="empty-hint-text">{{selectedService ? t['home.noMatchedCompanion'] : t['home.noRecommendCompanion']}}</text>
    </view>

    <view class="loading-hint" wx:if="{{loadingCompanions && companions.length > 0}}">
      <text>{{t['common.loading']}}</text>
    </view>

    <view class="load-more" wx:if="{{!loadingCompanions && companions.length > 0 && hasMore}}" bindtap="onLoadMore">
      <text class="load-more-text" wx:if="{{!loadingMore}}">{{t['home.loadMore']}}</text>
      <text class="load-more-text" wx:else>{{t['common.loading']}}</text>
    </view>

    <view class="no-more-hint" wx:if="{{!loadingCompanions && companions.length > 0 && !hasMore}}">
      <text>{{t['home.allShown']}}</text>
    </view>
  </view>
</view>

<!-- 城市选择弹窗 -->
<view class="city-modal-mask" wx:if="{{showCityPicker}}" bindtap="onCloseCityPicker">
  <view class="city-modal" catchtap>
    <view class="city-modal-header">
      <text class="city-modal-title">{{t['home.selectCity']}}</text>
      <text class="city-modal-close" bindtap="onCloseCityPicker">✕</text>
    </view>
    <view class="city-modal-body">
      <view class="city-option city-option-locate" bindtap="onAutoLocate">
        <text class="city-option-icon">📍</text>
        <text class="city-option-text">{{t['home.autoLocate']}}</text>
        <text class="city-option-hint" wx:if="{{locating}}">{{t['city.locating']}}</text>
      </view>
      <view class="city-list-title" wx:if="{{allCities.length > 0}}">
        <text>{{t['home.availableCities']}}</text>
      </view>
      <view
        class="city-option {{city === item ? 'active' : ''}}"
        wx:for="{{allCities}}"
        wx:key="*this"
        data-city="{{item}}"
        bindtap="onSelectCity"
      >
        <text class="city-option-text">{{item}}</text>
        <text class="city-option-check" wx:if="{{city === item}}">✓</text>
      </view>
    </view>
  </view>
</view>

<patient-tab-bar active="home" />
