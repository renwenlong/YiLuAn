<view class="delete-account-page">
  <!-- 顶部警告区域 -->
  <view class="warning-header">
    <view class="warning-icon">⚠</view>
    <text class="warning-title">{{t['deleteAccount.title']}}</text>
    <text class="warning-subtitle">{{t['deleteAccount.subtitle']}}</text>
  </view>

  <!-- 数据说明卡片 -->
  <view class="data-card">
    <text class="card-title">{{t['deleteAccount.dataCardTitle']}}</text>
    <view class="data-list">
      <view class="data-item">
        <text class="data-dot">•</text>
        <text class="data-text">{{t['deleteAccount.dataOrders']}}</text>
      </view>
      <view class="data-item">
        <text class="data-dot">•</text>
        <text class="data-text">{{t['deleteAccount.dataProfile']}}</text>
      </view>
      <view class="data-item">
        <text class="data-dot">•</text>
        <text class="data-text">{{t['deleteAccount.dataWallet']}}</text>
      </view>
      <view class="data-item">
        <text class="data-dot">•</text>
        <text class="data-text">{{t['deleteAccount.dataChat']}}</text>
      </view>
      <view class="data-item">
        <text class="data-dot">•</text>
        <text class="data-text">{{t['deleteAccount.dataCert']}}</text>
      </view>
    </view>
    <view class="recovery-notice">
      <text class="recovery-text">{{t['deleteAccount.recoveryNotice']}}</text>
    </view>
  </view>

  <!-- 验证码确认区域 -->
  <view class="verify-section">
    <text class="verify-title">{{t['deleteAccount.verifyPhone']}} {{phoneMask}}</text>
    <view class="code-row">
      <input
        class="code-input"
        type="number"
        maxlength="6"
        placeholder="{{t['deleteAccount.codePlaceholder']}}"
        bindinput="onCodeInput"
        value="{{code}}"
      />
      <button
        class="code-btn {{countdown > 0 ? 'code-btn-disabled' : ''}}"
        disabled="{{countdown > 0}}"
        bindtap="onSendCode"
      >
        {{countdown > 0 ? countdown + 's' : t['deleteAccount.getCode']}}
      </button>
    </view>
  </view>

  <!-- 确认复选框 -->
  <view class="confirm-check" bindtap="onToggleConfirm">
    <view class="checkbox {{confirmed ? 'checkbox-checked' : ''}}">
      <text wx:if="{{confirmed}}" class="checkbox-icon">✓</text>
    </view>
    <text class="confirm-label">{{t['deleteAccount.confirmLabel']}}</text>
  </view>

  <!-- 底部按钮区域 -->
  <view class="btn-area">
    <view class="long-press-wrapper">
      <button
        class="btn-delete {{canSubmit ? (pressing ? 'btn-pressing' : '') : 'btn-disabled'}}"
        disabled="{{!canSubmit}}"
        bindtouchstart="onPressStart"
        bindtouchend="onPressEnd"
        bindtouchcancel="onPressEnd"
      >
        {{pressing ? pressCountdown : t['deleteAccount.longPress']}}
      </button>
      <!-- 长按进度条 -->
      <view class="press-progress" wx:if="{{pressing}}">
        <view class="press-progress-bar" style="animation-duration: 3s;"></view>
      </view>
    </view>
    <button class="btn-cancel" bindtap="onCancel">{{t['common.cancel']}}</button>
  </view>
</view>
