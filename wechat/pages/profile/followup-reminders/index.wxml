<view class="page">
  <view class="hint">在已完成订单中可以创建复诊提醒</view>

  <view class="empty" wx:if="{{!loading && items.length === 0}}">还没有复诊提醒</view>

  <view class="card" wx:for="{{items}}" wx:key="id">
    <view class="card-head">
      <text class="time">{{item.remind_at_display}}</text>
      <text class="status status-{{item.status}}">{{item.status_label}}</text>
    </view>
    <view class="note" wx:if="{{item.note}}">{{item.note}}</view>
    <view class="meta">订单 #{{item.order_short}}</view>
    <view class="actions" wx:if="{{item.can_cancel}}">
      <text class="link link-danger" data-id="{{item.id}}" bindtap="onCancelTap">取消</text>
    </view>
  </view>
</view>
