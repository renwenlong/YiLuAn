<view class="page">
  <view class="hint">{{t['followupReminders.hint']}}</view>

  <view class="empty" wx:if="{{!loading && items.length === 0}}">{{t['followupReminders.empty']}}</view>

  <view class="card" wx:for="{{items}}" wx:key="id">
    <view class="card-head">
      <text class="time">{{item.remind_at_display}}</text>
      <text class="status status-{{item.status}}">{{item.status_label}}</text>
    </view>
    <view class="note" wx:if="{{item.note}}">{{item.note}}</view>
    <view class="meta">{{item.order_no_text}}</view>
    <view class="actions" wx:if="{{item.can_cancel}}">
      <text class="link link-danger" data-id="{{item.id}}" bindtap="onCancelTap">{{t['followupReminders.cancel']}}</text>
    </view>
  </view>
</view>
