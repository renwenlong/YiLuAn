<view class="page">
  <view class="hint">{{t['emergencyContacts.hint']}}</view>

  <view class="contact-list">
    <view class="contact-card" wx:for="{{contacts}}" wx:key="id">
      <view class="contact-info">
        <view class="contact-name">{{item.name}} <text class="contact-rel">{{item.relationship}}</text></view>
        <view class="contact-phone">{{item.phone}}</view>
      </view>
      <view class="contact-actions">
        <text class="link-btn" data-id="{{item.id}}" bindtap="onEditTap">{{t['emergencyContacts.edit']}}</text>
        <text class="link-btn link-danger" data-id="{{item.id}}" bindtap="onDeleteTap">{{t['emergencyContacts.delete']}}</text>
      </view>
    </view>
    <view class="empty" wx:if="{{!loading && contacts.length === 0}}">{{t['emergencyContacts.empty']}}</view>
  </view>

  <button class="add-btn" bindtap="onAddTap" disabled="{{!canAdd}}">
    {{ canAdd ? t['emergencyContacts.addBtn'] : t['emergencyContacts.limitReached'] }}
  </button>

  <view class="modal-mask" wx:if="{{showForm}}" bindtap="onCancelForm" />
  <view class="modal" wx:if="{{showForm}}">
    <view class="modal-title">{{ editingId ? t['emergencyContacts.editTitle'] : t['emergencyContacts.addTitle'] }}</view>
    <view class="form-row">
      <text class="form-label">{{t['emergencyContacts.nameLabel']}}</text>
      <input class="form-input" placeholder="{{t['emergencyContacts.namePlaceholder']}}" value="{{form.name}}" bindinput="onNameInput" maxlength="50" />
    </view>
    <view class="form-row">
      <text class="form-label">{{t['emergencyContacts.phoneLabel']}}</text>
      <input class="form-input" placeholder="{{t['emergencyContacts.phonePlaceholder']}}" type="number" value="{{form.phone}}" bindinput="onPhoneInput" maxlength="11" />
    </view>
    <view class="form-row">
      <text class="form-label">{{t['emergencyContacts.relationLabel']}}</text>
      <input class="form-input" placeholder="{{t['emergencyContacts.relationPlaceholder']}}" value="{{form.relationship}}" bindinput="onRelationshipInput" maxlength="20" />
    </view>
    <view class="modal-actions">
      <button class="btn-secondary" bindtap="onCancelForm">{{t['common.cancel']}}</button>
      <button class="btn-primary" bindtap="onSubmit">{{t['common.save']}}</button>
    </view>
  </view>
</view>
