<view class="wallet-page">
  <!-- 余额卡片 -->
  <view class="balance-card {{role === 'companion' ? 'companion-card' : ''}}">
    <text class="balance-label">{{role === 'companion' ? t['wallet.balanceCompanion'] : t['wallet.balancePatient']}}</text>
    <text class="balance-value">{{balanceText}}</text>
  </view>

  <!-- 患者端：充值区域 -->
  <block wx:if="{{role !== 'companion'}}">
    <view class="recharge-section">
      <view class="section-title">{{t['wallet.selectAmount']}}</view>
      <view class="amount-grid">
        <view
          class="amount-item {{selectedAmount === item ? 'active' : ''}}"
          wx:for="{{amountOptions}}"
          wx:key="*this"
          data-amount="{{item}}"
          bindtap="onSelectAmount"
        >
          <text class="amount-value">{{amountOptionsText[index]}}</text>
        </view>
      </view>

      <view class="custom-amount">
        <text class="custom-label">{{t['wallet.customAmount']}}</text>
        <input
          class="custom-input"
          type="digit"
          placeholder="{{t['wallet.inputAmount']}}"
          value="{{customAmount}}"
          bindinput="onCustomInput"
          bindtap="onCustomTap"
        />
      </view>

      <button class="recharge-btn" bindtap="onRecharge">{{t['wallet.rechargeNow']}}</button>
    </view>
  </block>

  <!-- 陪诊师端：提现区域 -->
  <block wx:if="{{role === 'companion'}}">
    <view class="withdraw-section">
      <view class="withdraw-info">
        <view class="withdraw-row">
          <text class="withdraw-label">{{t['wallet.totalIncome']}}</text>
          <text class="withdraw-value">{{totalIncomeText}}</text>
        </view>
        <view class="withdraw-row">
          <text class="withdraw-label">{{t['wallet.withdrawn']}}</text>
          <text class="withdraw-value">{{withdrawnText}}</text>
        </view>
      </view>
      <button class="withdraw-btn" bindtap="onWithdraw">{{t['wallet.applyWithdraw']}}</button>
    </view>
  </block>

  <!-- 明细记录 -->
  <view class="record-section">
    <view class="section-header">
      <text class="section-title">{{role === 'companion' ? t['wallet.incomeDetail'] : t['wallet.expenseDetail']}}</text>
    </view>
    <block wx:if="{{records.length > 0}}">
      <view class="record-item" wx:for="{{records}}" wx:key="id">
        <view class="record-left">
          <text class="record-title">{{item.title}}</text>
          <text class="record-time">{{item.time}}</text>
        </view>
        <text class="record-amount {{item.type === 'income' ? 'income' : 'expense'}}">
          {{item.type === 'income' ? '+' : '-'}}{{item.amountText}}
        </text>
      </view>
    </block>
    <view class="empty-hint" wx:else>
      <text>{{role === 'companion' ? t['wallet.noIncome'] : t['wallet.noExpense']}}</text>
    </view>
  </view>
</view>
