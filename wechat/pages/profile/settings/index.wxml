<view class="settings-page">
  <view class="settings-section">
    <view class="settings-item" wx:if="{{user.role === 'companion'}}" bindtap="onCityTap">
      <text class="item-label">{{t['settings.myCity']}}</text>
      <view class="item-right">
        <text class="item-value">{{city || t['common.notSet']}}</text>
        <text class="item-arrow">></text>
      </view>
    </view>
    <view class="settings-item" bindtap="onSwitchRole">
      <text class="item-label">{{switchRoleLabel}}</text>
      <view class="item-right">
        <text class="item-value">{{currentRoleLabel}}</text>
        <text class="item-arrow">></text>
      </view>
    </view>
    <view class="settings-item" bindtap="onChangePhone">
      <text class="item-label">{{t['settings.myPhone']}}</text>
      <view class="item-right">
        <text class="item-value">{{user.phone || t['common.notBound']}}</text>
        <text class="item-arrow">></text>
      </view>
    </view>
    <view class="settings-item" bindtap="onLanguageTap">
      <text class="item-label">{{t['settings.language']}}</text>
      <view class="item-right">
        <text class="item-value">{{langLabel}}</text>
        <text class="item-arrow">></text>
      </view>
    </view>
    <view class="settings-item" bindtap="onClearCache">
      <text class="item-label">{{t['settings.clearCache']}}</text>
      <view class="item-right">
        <text class="item-value">{{cacheSize}}</text>
        <text class="item-arrow">></text>
      </view>
    </view>
    <view class="settings-item" bindtap="onPrivacyPolicy">
      <text class="item-label">{{t['settings.privacyPolicy']}}</text>
      <view class="item-right">
        <text class="item-arrow">></text>
      </view>
    </view>
    <view class="settings-item" bindtap="onUserAgreement">
      <text class="item-label">{{t['settings.termsOfService']}}</text>
      <view class="item-right">
        <text class="item-arrow">></text>
      </view>
    </view>
    <view class="settings-item" bindtap="onAbout">
      <text class="item-label">{{t['settings.about']}}</text>
      <view class="item-right">
        <text class="item-arrow">></text>
      </view>
    </view>
  </view>

  <view class="settings-section settings-section-danger">
    <view class="settings-item" bindtap="onDeleteAccount">
      <text class="item-label item-label-danger">{{t['settings.deleteAccount']}}</text>
      <view class="item-right">
        <text class="item-arrow">></text>
      </view>
    </view>
  </view>

  <!-- 语言选择弹窗 (AC-4) -->
  <view class="city-modal-mask" wx:if="{{showLangPicker}}" bindtap="onCloseLangPicker">
    <view class="city-modal" catchtap>
      <view class="city-modal-header">
        <text class="city-modal-title">{{t['settings.language']}}</text>
        <text class="city-modal-close" bindtap="onCloseLangPicker">✕</text>
      </view>
      <view class="city-modal-body">
        <view
          class="city-option {{currentLang === 'zh-Hans' ? 'active' : ''}}"
          data-lang="zh-Hans"
          bindtap="onSelectLang"
        >
          <text class="city-option-text">{{t['settings.languageZh']}}</text>
          <text class="city-option-check" wx:if="{{currentLang === 'zh-Hans'}}">✓</text>
        </view>
        <view
          class="city-option {{currentLang === 'en' ? 'active' : ''}}"
          data-lang="en"
          bindtap="onSelectLang"
        >
          <text class="city-option-text">{{t['settings.languageEn']}}</text>
          <text class="city-option-check" wx:if="{{currentLang === 'en'}}">✓</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 城市选择弹窗 -->
  <view class="city-modal-mask" wx:if="{{showCityPicker}}" bindtap="onCloseCityPicker">
    <view class="city-modal" catchtap>
      <view class="city-modal-header">
        <text class="city-modal-title">{{t['settings.selectCity']}}</text>
        <text class="city-modal-close" bindtap="onCloseCityPicker">✕</text>
      </view>
      <view class="city-modal-body">
        <view class="city-option city-option-locate" bindtap="onAutoLocate">
          <text class="city-option-icon">📍</text>
          <text class="city-option-text">{{t['settings.autoLocate']}}</text>
          <text class="city-option-hint" wx:if="{{locating}}">{{t['city.locating']}}</text>
        </view>
        <view class="city-list-title" wx:if="{{allCities.length > 0}}">
          <text>{{t['settings.availableCities']}}</text>
        </view>
        <view
          class="city-option {{city === item ? 'active' : ''}}"
          wx:for="{{allCities}}"
          wx:key="*this"
          data-city="{{item}}"
          bindtap="onSelectCity"
        >
          <text class="city-option-text">{{item}}</text>
          <text class="city-option-check" wx:if="{{city === item}}">✓</text>
        </view>
      </view>
    </view>
  </view>
</view>
