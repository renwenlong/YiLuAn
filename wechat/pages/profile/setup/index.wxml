<view class="setup-page">
  <view class="page-header">
    <text class="title">{{t['profileSetup.title']}}</text>
    <text class="subtitle">{{t['profileSetup.subtitle']}}</text>
  </view>

  <view class="avatar-section" bindtap="onChooseAvatar">
    <image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" class="avatar-img" mode="aspectFill" />
    <view wx:else class="avatar-placeholder">
      <text class="avatar-placeholder-text">+</text>
    </view>
    <text class="avatar-hint">{{t['profileSetup.uploadAvatar']}}</text>
  </view>

  <view class="form-section">
    <view class="form-group">
      <text class="form-label">{{t['profileSetup.nickname']}} <text class="required">*</text></text>
      <input
        class="form-input"
        placeholder="{{t['profileSetup.inputNickname']}}"
        maxlength="20"
        value="{{nickname}}"
        bindinput="onNicknameInput"
      />
    </view>

    <view class="form-group">
      <text class="form-label">{{t['login.phone']}} <text class="required">*</text></text>
      <view class="phone-row">
        <input
          class="form-input phone-input"
          type="number"
          maxlength="11"
          placeholder="{{t['login.inputPhone']}}"
          value="{{phone}}"
          bindinput="onPhoneInput"
        />
        <button class="otp-btn" disabled="{{sending || countdown > 0}}" bindtap="onSendOTP">
          {{countdown > 0 ? countdown + 's' : t['login.getCode']}}
        </button>
      </view>
    </view>

    <view class="form-group">
      <text class="form-label">{{t['login.codeLabel']}} <text class="required">*</text></text>
      <input
        class="form-input"
        type="number"
        maxlength="6"
        placeholder="{{t['login.inputCode']}}"
        value="{{code}}"
        bindinput="onCodeInput"
      />
    </view>
  </view>

  <view class="btn-section">
    <button class="btn-submit" bindtap="onSubmit" disabled="{{saving}}">
      {{saving ? t['profileSetup.saving'] : t['profileSetup.finishSetup']}}
    </button>
    <view class="skip-link" bindtap="onSkip">
      <text>{{t['profileSetup.skip']}}</text>
    </view>
  </view>

  <view class="loading-mask" wx:if="{{saving}}">
    <view class="loading-spinner"></view>
  </view>
</view>
