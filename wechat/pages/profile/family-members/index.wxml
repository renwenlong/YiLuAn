<view class="page">
  <view class="hint">{{t['familyMembers.hint']}}</view>

  <view class="member-list">
    <view class="member-card" wx:for="{{members}}" wx:key="id">
      <view class="member-info">
        <view class="member-name">{{item.name}} <text class="member-rel">{{item.relation_label}}</text></view>
        <view class="member-meta">
          <text wx:if="{{item.phone}}" class="meta-item">📞 {{item.phone}}</text>
          <text wx:if="{{item.age != null}}" class="meta-item">{{item.ageText}}</text>
        </view>
        <view class="member-notes" wx:if="{{item.medical_notes}}">{{item.medical_notes}}</view>
      </view>
      <view class="member-actions">
        <text class="link-btn" data-id="{{item.id}}" bindtap="onEditTap">{{t['familyMembers.edit']}}</text>
        <text class="link-btn link-danger" data-id="{{item.id}}" bindtap="onDeleteTap">{{t['familyMembers.delete']}}</text>
      </view>
    </view>
    <view class="empty" wx:if="{{!loading && members.length === 0}}">{{t['familyMembers.empty']}}</view>
  </view>

  <button class="add-btn" bindtap="onAddTap">{{t['familyMembers.addBtn']}}</button>

  <view class="modal-mask" wx:if="{{showForm}}" bindtap="onCancelForm" />
  <view class="modal" wx:if="{{showForm}}">
    <view class="modal-title">{{ editingId ? t['familyMembers.editTitle'] : t['familyMembers.addTitle'] }}</view>
    <view class="form-row">
      <text class="form-label">{{t['familyMembers.nameLabel']}}</text>
      <input class="form-input" placeholder="{{t['familyMembers.namePlaceholder']}}" value="{{form.name}}" bindinput="onNameInput" maxlength="50" />
    </view>
    <view class="form-row">
      <text class="form-label">{{t['familyMembers.relationLabel']}}</text>
      <picker mode="selector" range="{{relationLabels}}" value="{{relationIndex}}" bindchange="onRelationChange">
        <view class="picker-value">{{relationLabels[relationIndex]}}</view>
      </picker>
    </view>
    <view class="form-row">
      <text class="form-label">{{t['familyMembers.phoneLabel']}}</text>
      <input class="form-input" placeholder="{{t['familyMembers.phonePlaceholder']}}" type="number" value="{{form.phone}}" bindinput="onPhoneInput" maxlength="11" />
    </view>
    <view class="form-row">
      <text class="form-label">{{t['familyMembers.genderLabel']}}</text>
      <picker mode="selector" range="{{genderLabels}}" value="{{genderIndex}}" bindchange="onGenderChange">
        <view class="picker-value">{{genderLabels[genderIndex]}}</view>
      </picker>
    </view>
    <view class="form-row">
      <text class="form-label">{{t['familyMembers.ageLabel']}}</text>
      <input class="form-input" placeholder="{{t['familyMembers.agePlaceholder']}}" type="number" value="{{form.age}}" bindinput="onAgeInput" maxlength="3" />
    </view>
    <view class="form-row form-row-vertical">
      <text class="form-label">{{t['familyMembers.notesLabel']}}</text>
      <textarea class="form-textarea" placeholder="{{t['familyMembers.notesPlaceholder']}}" value="{{form.medical_notes}}" bindinput="onNotesInput" maxlength="500" />
    </view>
    <view class="modal-actions">
      <button class="btn-secondary" bindtap="onCancelForm">{{t['common.cancel']}}</button>
      <button class="btn-primary" bindtap="onSubmit">{{t['common.save']}}</button>
    </view>
  </view>
</view>
