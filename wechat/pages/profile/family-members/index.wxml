<view class="page">
  <view class="hint">添加家人后，下单时可指定为其本人就诊</view>

  <view class="member-list">
    <view class="member-card" wx:for="{{members}}" wx:key="id">
      <view class="member-info">
        <view class="member-name">{{item.name}} <text class="member-rel">{{item.relation_label}}</text></view>
        <view class="member-meta">
          <text wx:if="{{item.phone}}" class="meta-item">📞 {{item.phone}}</text>
          <text wx:if="{{item.age != null}}" class="meta-item">{{item.age}} 岁</text>
        </view>
        <view class="member-notes" wx:if="{{item.medical_notes}}">{{item.medical_notes}}</view>
      </view>
      <view class="member-actions">
        <text class="link-btn" data-id="{{item.id}}" bindtap="onEditTap">编辑</text>
        <text class="link-btn link-danger" data-id="{{item.id}}" bindtap="onDeleteTap">删除</text>
      </view>
    </view>
    <view class="empty" wx:if="{{!loading && members.length === 0}}">还没有添加家人</view>
  </view>

  <button class="add-btn" bindtap="onAddTap">+ 添加家人</button>

  <view class="modal-mask" wx:if="{{showForm}}" bindtap="onCancelForm" />
  <view class="modal" wx:if="{{showForm}}">
    <view class="modal-title">{{ editingId ? '编辑家人' : '添加家人' }}</view>
    <view class="form-row">
      <text class="form-label">姓名</text>
      <input class="form-input" placeholder="如 王芳" value="{{form.name}}" bindinput="onNameInput" maxlength="50" />
    </view>
    <view class="form-row">
      <text class="form-label">关系</text>
      <picker mode="selector" range="{{relationLabels}}" value="{{relationIndex}}" bindchange="onRelationChange">
        <view class="picker-value">{{relationLabels[relationIndex]}}</view>
      </picker>
    </view>
    <view class="form-row">
      <text class="form-label">手机号</text>
      <input class="form-input" placeholder="11 位手机号（选填）" type="number" value="{{form.phone}}" bindinput="onPhoneInput" maxlength="11" />
    </view>
    <view class="form-row">
      <text class="form-label">性别</text>
      <picker mode="selector" range="{{genderLabels}}" value="{{genderIndex}}" bindchange="onGenderChange">
        <view class="picker-value">{{genderLabels[genderIndex]}}</view>
      </picker>
    </view>
    <view class="form-row">
      <text class="form-label">年龄</text>
      <input class="form-input" placeholder="0-130（选填）" type="number" value="{{form.age}}" bindinput="onAgeInput" maxlength="3" />
    </view>
    <view class="form-row form-row-vertical">
      <text class="form-label">病情备注</text>
      <textarea class="form-textarea" placeholder="过敏史、慢性病等（选填）" value="{{form.medical_notes}}" bindinput="onNotesInput" maxlength="500" />
    </view>
    <view class="modal-actions">
      <button class="btn-secondary" bindtap="onCancelForm">取消</button>
      <button class="btn-primary" bindtap="onSubmit">保存</button>
    </view>
  </view>
</view>
