<view class="bind-phone-page">
  <view class="form-section">
    <view class="form-group">
      <text class="form-label">{{t['login.phone']}}</text>
      <view class="phone-row">
        <input
          class="form-input phone-input"
          type="number"
          maxlength="11"
          placeholder="{{t['login.inputPhone']}}"
          value="{{phone}}"
          bindinput="onPhoneInput"
        />
        <button
          class="otp-btn"
          disabled="{{sending || countdown > 0}}"
          bindtap="onSendOTP"
        >
          {{countdown > 0 ? countdown + 's' : t['login.getCode']}}
        </button>
      </view>
    </view>
    <view class="form-group">
      <text class="form-label">{{t['login.codeLabel']}}</text>
      <input
        class="form-input"
        type="number"
        maxlength="6"
        placeholder="{{t['login.inputCode']}}"
        value="{{code}}"
        bindinput="onCodeInput"
      />
    </view>
    <view class="btn-section">
      <button class="btn-bind" bindtap="onBind" disabled="{{binding}}">
        {{binding ? t['bindPhone.submitting'] : t['bindPhone.bindNow']}}
      </button>
    </view>
  </view>
</view>
