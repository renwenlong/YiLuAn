<loading-overlay wx:if="{{loading}}" />

<view class="page-container" wx:if="{{companion}}">
  <!-- Profile Header -->
  <view class="profile-header">
    <view class="profile-header-decor"></view>
    <image
      class="profile-avatar"
      src="{{companion.avatar}}"
      mode="aspectFill"
      bindtap="onPreviewAvatar"
    />
    <view class="profile-name-row">
      <text class="profile-name">{{companion.name}}</text>
      <text wx:if="{{companion.is_verified}}" class="verified-badge">{{t['companionDetail.verified']}}</text>
      <text wx:else class="unverified-badge">{{t['companionDetail.unverified']}}</text>
      <!--
        S3-DEV-003-TRUST-UI-WX AC#3: 删除 '已认证·{{certificationType}}'
        职业背书徽章 (例 '已认证·护士执业证' 隐含医疗权威背书).
        上面 'is_verified' 徽章 已足 trust signal, 具体 cert 资质
        走订单详情页 <cert-card> (仅 patient/order-detail 展,
        代入后端同一 ABAC 处理后的 companion_cert_qualifications 详细表).
      -->
    </view>
    <view class="profile-rating" wx:if="{{companion.rating > 0}}">
      <rating-stars value="{{companion.rating}}" readonly="{{true}}" />
      <text class="rating-text">{{companion.ratingText}}</text>
    </view>
    <view class="profile-rating" wx:else>
      <text class="rating-text no-rating-text">{{t['companionDetail.noRating']}}</text>
    </view>
  </view>

  <!-- Bio -->
  <view class="detail-section">
    <view class="section-title">{{t['companionDetail.bioTitle']}}</view>
    <text class="bio-text">{{companion.bio || t['companionDetail.noBio']}}</text>
  </view>

  <!-- Service Info -->
  <view class="detail-section">
    <view class="section-title">{{t['companionDetail.serviceInfo']}}</view>
    <view class="info-row">
      <text class="info-label">{{t['companionDetail.serviceArea']}}</text>
      <text class="info-value">{{companion.serviceArea || t['companionDetail.none']}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">{{t['companionDetail.completedOrders']}}</text>
      <text class="info-value">{{companion.ordersText}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">{{t['companionDetail.experience']}}</text>
      <text class="info-value">{{companion.experience || t['companionDetail.none']}}</text>
    </view>

    <view class="service-areas" wx:if="{{companion.serviceAreas && companion.serviceAreas.length > 0}}">
      <text class="info-label">{{t['companionDetail.expertise']}}</text>
      <view class="tag-list">
        <text class="tag" wx:for="{{companion.serviceAreas}}" wx:key="*this">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- F-04: Multi-dimension scores -->
  <view class="detail-section" wx:if="{{companion.dimensionScores}}">
    <view class="section-title">{{t['companionDetail.dimensionScores']}}</view>
    <view class="dimension-bar">
      <text class="dimension-name">{{t['companionDetail.dimPunctuality']}}</text>
      <view class="bar-track">
        <view class="bar-fill" style="width: {{companion.dimensionScores.punctuality * 20}}%;"></view>
      </view>
      <text class="dimension-num">{{companion.dimensionScores.punctuality}}</text>
    </view>
    <view class="dimension-bar">
      <text class="dimension-name">{{t['companionDetail.dimProfessionalism']}}</text>
      <view class="bar-track">
        <view class="bar-fill" style="width: {{companion.dimensionScores.professionalism * 20}}%;"></view>
      </view>
      <text class="dimension-num">{{companion.dimensionScores.professionalism}}</text>
    </view>
    <view class="dimension-bar">
      <text class="dimension-name">{{t['companionDetail.dimCommunication']}}</text>
      <view class="bar-track">
        <view class="bar-fill" style="width: {{companion.dimensionScores.communication * 20}}%;"></view>
      </view>
      <text class="dimension-num">{{companion.dimensionScores.communication}}</text>
    </view>
    <view class="dimension-bar">
      <text class="dimension-name">{{t['companionDetail.dimAttitude']}}</text>
      <view class="bar-track">
        <view class="bar-fill" style="width: {{companion.dimensionScores.attitude * 20}}%;"></view>
      </view>
      <text class="dimension-num">{{companion.dimensionScores.attitude}}</text>
    </view>
  </view>

  <!-- Reviews -->
  <view class="detail-section">
    <view class="section-title">{{t['companionDetail.reviewsTitle']}} ({{reviews.length}})</view>
    <view class="review-list" wx:if="{{reviews.length > 0}}">
      <view class="review-item" wx:for="{{reviews}}" wx:key="id">
        <view class="review-header">
          <text class="review-user">{{item.userName}}</text>
          <rating-stars value="{{item.rating}}" readonly="{{true}}" size="small" />
        </view>
        <text class="review-content">{{item.content}}</text>
        <text class="review-date">{{item.date}}</text>
      </view>
    </view>
    <view class="empty-reviews">
      <text class="empty-reviews-icon">💬</text>
      <text>{{t['companionDetail.emptyReviews']}}</text>
    </view>
  </view>

  <!-- Bottom Spacer for fixed button -->
  <view class="bottom-spacer"></view>

  <!-- Book Button -->
  <view class="book-bar">
    <button class="btn-book" bindtap="onBook">{{t['companionDetail.book']}}</button>
  </view>
</view>
