<view class="profile-page">
  <!-- User Info Section -->
  <view class="user-section">
    <view class="user-info">
      <view class="user-avatar" bindtap="onAvatarTap">
        <image wx:if="{{user.avatar}}" src="{{user.avatar}}" class="avatar-img" />
        <view wx:else class="avatar-placeholder">
          <text>{{user.name[0] || t['profile.avatarFallback']}}</text>
        </view>
        <view class="avatar-edit-hint">
          <text>{{t['profile.changeAvatar']}}</text>
        </view>
      </view>
      <view class="user-detail">
        <view class="user-name-row">
          <text class="user-name">{{user.name || t['profile.defaultUser']}}</text>
          <text wx:if="{{user.role === 'companion'}}" class="role-badge companion-badge">{{t['role.companion']}}</text>
          <text wx:elif="{{user.role === 'patient'}}" class="role-badge patient-badge">{{t['role.patient']}}</text>
        </view>

        <view class="user-phone" wx:if="{{user.phone}}">
          <text class="phone-text">{{user.phone}}</text>
        </view>
        <view class="user-phone bind-phone" wx:else bindtap="onBindPhone">
          <text class="phone-text unbind">{{t['profile.unbindPhone']}}</text>
          <text class="bind-btn">{{t['profile.goBind']}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Menu List -->
  <view class="menu-section">
    <view class="menu-item" data-target="/pages/profile/edit/index" bindtap="onMenuTap">
      <text class="menu-text">{{t['profile.menuEdit']}}</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" data-target="/pages/companion/orders/index" bindtap="onMenuTap">
      <text class="menu-text">{{t['profile.menuOrders']}}</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" data-target="/pages/profile/wallet/index" bindtap="onMenuTap">
      <text class="menu-text">{{t['profile.menuWallet']}}</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" data-target="/pages/profile/settings/index" bindtap="onMenuTap">
      <text class="menu-text">{{t['profile.menuSettings']}}</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <!-- Logout -->
  <view class="logout-section">
    <button class="logout-btn" bindtap="onLogout">{{t['profile.logout']}}</button>
  </view>
</view>

<companion-tab-bar active="profile" />
