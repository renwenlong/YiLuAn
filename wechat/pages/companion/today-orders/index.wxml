<loading-overlay wx:if="{{loading && orders.length === 0}}" />

<view class="page-container">
  <view class="order-list" wx:if="{{orders.length > 0}}">
    <order-card
      wx:for="{{orders}}"
      wx:key="id"
      order="{{item}}"
      data-id="{{item.id}}"
      bindtap="onOrderTap"
    />
  </view>

  <empty-state
    wx:if="{{!loading && orders.length === 0}}"
    icon="order"
    text="{{t['order.todayEmpty']}}"
    subText="{{t['order.todayEmptySub']}}"
  />

  <view class="load-more" wx:if="{{loading && orders.length > 0}}">
    <text>{{t['common.loading']}}</text>
  </view>
</view>
