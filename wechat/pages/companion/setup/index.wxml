<view class="setup-page">
  <view class="page-header">
    <text class="title">{{t['companionSetup.title']}}</text>
    <text class="subtitle">{{t['companionSetup.subtitle']}}</text>
  </view>

  <view class="form-section">
    <!-- 真实姓名 -->
    <view class="form-group">
      <text class="form-label">{{t['companionSetup.realName']}} <text class="required">*</text></text>
      <input
        class="form-input"
        placeholder="{{t['companionSetup.realNamePlaceholder']}}"
        maxlength="20"
        value="{{realName}}"
        data-field="realName"
        bindinput="onInputChange"
      />
    </view>

    <!-- 手机号 -->
    <view class="form-group">
      <text class="form-label">{{t['companionSetup.phone']}} <text class="required">*</text></text>
      <block wx:if="{{phoneBound}}">
        <view class="phone-bound-row">
          <text class="phone-bound-text">{{phone}}</text>
          <text class="phone-bound-tag">{{t['companionSetup.phoneVerified']}}</text>
        </view>
      </block>
      <block wx:else>
        <view class="phone-row">
          <input
            class="form-input phone-input"
            type="number"
            maxlength="11"
            placeholder="{{t['companionSetup.phonePlaceholder']}}"
            value="{{phone}}"
            bindinput="onPhoneInput"
          />
          <button
            class="otp-btn"
            disabled="{{sendingOTP || countdown > 0}}"
            bindtap="onSendOTP"
          >
            {{countdown > 0 ? countdown + 's' : t['companionSetup.getCode']}}
          </button>
        </view>
        <view class="code-row">
          <input
            class="form-input code-input"
            type="number"
            maxlength="6"
            placeholder="{{t['companionSetup.codePlaceholder']}}"
            value="{{code}}"
            bindinput="onCodeInput"
          />
          <button
            class="verify-btn"
            disabled="{{bindingPhone}}"
            bindtap="onBindPhone"
          >
            {{bindingPhone ? t['companionSetup.verifying'] : t['companionSetup.verify']}}
          </button>
        </view>
      </block>
    </view>

    <!-- 服务类型 -->
    <view class="form-group">
      <text class="form-label">{{t['companionSetup.serviceType']}} <text class="required">*</text></text>
      <text class="form-hint-text">{{t['companionSetup.serviceTypeHint']}}</text>
      <view class="tag-select-list">
        <view
          class="tag-select-item {{serviceTypeMap[item.key] ? 'selected' : ''}}"
          wx:for="{{serviceTypeList}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onServiceTypeToggle"
        >
          <text class="tag-select-name">{{item.label}}</text>
          <text class="tag-select-check" wx:if="{{serviceTypeMap[item.key]}}">✓</text>
        </view>
      </view>
    </view>

    <!-- 认证资质 -->
    <view class="form-group">
      <text class="form-label">{{t['companionSetup.certifications']}} <text class="recommend">{{t['companionSetup.optional']}}</text></text>
      <textarea
        class="form-textarea form-textarea-sm"
        placeholder="{{t['companionSetup.certificationsPlaceholder']}}"
        value="{{certifications}}"
        data-field="certifications"
        bindinput="onInputChange"
        maxlength="500"
        auto-height
      />
    </view>

    <!-- 个人简介 -->
    <view class="form-group">
      <text class="form-label">{{t['companionSetup.bio']}}</text>
      <textarea
        class="form-textarea"
        placeholder="{{t['companionSetup.bioPlaceholder']}}"
        value="{{bio}}"
        data-field="bio"
        bindinput="onInputChange"
        maxlength="500"
      />
    </view>

    <!-- 服务区域 -->
    <view class="form-group">
      <text class="form-label">{{t['companionSetup.serviceDistrict']}}{{cityWrap}} <text class="recommend">{{t['companionSetup.recommend']}}</text></text>
      <text class="form-hint-text">{{t['companionSetup.serviceDistrictHint']}}</text>
      <text class="form-hint" wx:if="{{serviceDistricts.length === 0 && !locating}}">{{t['companionSetup.noDistrictData']}}</text>
      <text class="form-hint" wx:if="{{locating}}">{{t['companionSetup.locating']}}</text>
      <view class="district-select-list" wx:if="{{serviceDistricts.length > 0}}">
        <view
          class="district-select-item {{districtMap[item] ? 'selected' : ''}}"
          wx:for="{{serviceDistricts}}"
          wx:key="*this"
          data-name="{{item}}"
          bindtap="onDistrictToggle"
        >
          <text class="district-select-name">{{item}}</text>
          <text class="district-select-check" wx:if="{{districtMap[item]}}">✓</text>
        </view>
      </view>
    </view>

    <!-- 服务医院 -->
    <view class="form-group">
      <text class="form-label">{{t['companionSetup.serviceHospital']}}{{cityWrap}} <text class="recommend">{{t['companionSetup.recommend']}}</text></text>
      <text class="form-hint-text">{{t['companionSetup.serviceHospitalHint']}}</text>

      <!-- 搜索框 -->
      <view class="search-bar">
        <input
          class="search-input"
          placeholder="{{t['companionSetup.searchHospitalPlaceholder']}}"
          value="{{hospitalKeyword}}"
          bindinput="onHospitalSearch"
        />
      </view>

      <!-- 筛选条件 (picker下拉框) -->
      <view class="filter-section" wx:if="{{allDistricts.length > 1 || allLevels.length > 1 || allTags.length > 1}}">
        <view class="filter-row">
          <picker wx:if="{{allDistricts.length > 1}}" mode="selector" range="{{allDistricts}}" value="{{districtIndex}}" bindchange="onFilterDistrictChange" class="filter-picker-wrap">
            <view class="filter-picker">
              <text class="filter-picker-text">{{districtIndex === 0 ? t['companionSetup.filterDistrict'] : allDistricts[districtIndex]}}</text>
              <text class="filter-picker-arrow">▼</text>
            </view>
          </picker>
          <picker wx:if="{{allLevels.length > 1}}" mode="selector" range="{{allLevels}}" value="{{levelIndex}}" bindchange="onFilterLevelChange" class="filter-picker-wrap">
            <view class="filter-picker">
              <text class="filter-picker-text">{{levelIndex === 0 ? t['companionSetup.filterLevel'] : allLevels[levelIndex]}}</text>
              <text class="filter-picker-arrow">▼</text>
            </view>
          </picker>
          <picker wx:if="{{allTags.length > 1}}" mode="selector" range="{{allTags}}" value="{{tagIndex}}" bindchange="onFilterTagChange" class="filter-picker-wrap">
            <view class="filter-picker">
              <text class="filter-picker-text">{{tagIndex === 0 ? t['companionSetup.filterTag'] : allTags[tagIndex]}}</text>
              <text class="filter-picker-arrow">▼</text>
            </view>
          </picker>
        </view>
      </view>

      <!-- 医院列表 -->
      <text class="form-hint" wx:if="{{loadingHospitals}}">{{t['companionSetup.loadingHospitals']}}</text>
      <view class="hospital-select-list" wx:if="{{!loadingHospitals && allHospitals.length > 0}}">
        <view
          class="hospital-select-item {{hospitalIdMap[item.id] ? 'selected' : ''}}"
          wx:for="{{allHospitals}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onHospitalToggle"
        >
          <view class="hospital-info">
            <text class="hospital-select-name">{{item.name}}</text>
            <view class="hospital-meta">
              <text class="hospital-meta-text" wx:if="{{item.level}}">{{item.level}}</text>
              <text class="hospital-meta-text" wx:if="{{item.district}}">{{item.district}}</text>
            </view>
          </view>
          <text class="hospital-select-check" wx:if="{{hospitalIdMap[item.id]}}">✓</text>
        </view>
      </view>
      <text class="form-hint" wx:if="{{!loadingHospitals && allHospitals.length === 0 && city && !locating}}">{{t['companionSetup.noHospitalData']}}</text>
      <text class="form-hint" wx:if="{{!loadingHospitals && !city}}">{{t['companionSetup.locationFailed']}}</text>

      <!-- 已选计数 -->
      <text class="selected-count" wx:if="{{selectedHospitalIds.length > 0}}">{{selectedHospitalCountText}}</text>
    </view>
  </view>

  <view class="btn-section">
    <button class="btn-submit" bindtap="onSubmit" disabled="{{saving}}">
      {{saving ? t['companionSetup.submitting'] : t['companionSetup.submit']}}
    </button>
  </view>

  <view class="loading-mask" wx:if="{{saving}}">
    <view class="loading-spinner"></view>
  </view>
</view>
