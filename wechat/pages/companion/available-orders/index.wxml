<loading-overlay wx:if="{{loading && orders.length === 0}}" />

<view class="page-container">
  <!-- Order List -->
  <view class="order-list" wx:if="{{orders.length > 0}}">
    <view class="order-card-wrapper" wx:for="{{orders}}" wx:key="id">
      <order-card
        order="{{item}}"
        data-id="{{item.id}}"
        bindtap="onOrderTap"
      />
      <view class="accept-action">
        <button
          class="btn-accept"
          data-id="{{item.id}}"
          catchtap="onAccept"
        >{{t['availableOrders.accept']}}</button>
      </view>
    </view>
  </view>

  <!-- Empty State -->
  <empty-state
    wx:if="{{!loading && orders.length === 0}}"
    icon="order"
    text="{{t['availableOrders.empty']}}"
    subText="{{t['availableOrders.emptySub']}}"
  />

  <!-- Load More -->
  <view class="load-more" wx:if="{{loading && orders.length > 0}}">
    <text>{{t['common.loading']}}</text>
  </view>
  <view class="no-more" wx:if="{{!hasMore && orders.length > 0}}">
    <text>{{t['common.noMore']}}</text>
  </view>
</view>
