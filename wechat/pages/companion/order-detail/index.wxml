<loading-overlay wx:if="{{loading}}" />

<view class="page-container" wx:if="{{order}}">
  <!-- Status Header -->
  <view class="status-header status-{{order.status}}">
    <view class="status-header-decor"></view>
    <text class="status-text">{{statusList[order.status].label || order.status}}</text>
    <text class="status-subtitle" wx:if="{{order.status === 'created'}}">{{t['companionOrderDetail.subNewOrder']}}</text>
    <text class="status-subtitle" wx:elif="{{order.status === 'accepted'}}">{{t['companionOrderDetail.subAccepted']}}</text>
    <text class="status-subtitle" wx:elif="{{order.status === 'in_progress'}}">{{t['companionOrderDetail.subInProgress']}}</text>
    <text class="status-subtitle" wx:elif="{{order.status === 'completed'}}">{{t['companionOrderDetail.subCompleted']}}</text>
    <text class="status-subtitle" wx:elif="{{order.status === 'cancelled'}}">{{t['companionOrderDetail.subCancelled']}}</text>
  </view>

  <!-- Order Info -->
  <view class="detail-section">
    <view class="section-title">{{t['orderDetail.orderInfo']}}</view>
    <view class="info-row">
      <text class="info-label">{{t['orderDetail.orderNumber']}}</text>
      <text class="info-value">{{order.order_number}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">{{t['orderDetail.serviceTypeLabel']}}</text>
      <text class="info-value">{{serviceLabel}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">{{t['orderDetail.hospitalLabel']}}</text>
      <text class="info-value">{{order.hospital_name}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">{{t['orderDetail.appointmentTime']}}</text>
      <text class="info-value">{{order.appointment_date}} {{order.appointment_time}}</text>
    </view>
    <view class="info-row" wx:if="{{order.formattedPrice}}">
      <text class="info-label">{{t['orderDetail.feeLabel']}}</text>
      <text class="info-value price">{{order.formattedPrice}}</text>
    </view>
    <view class="info-row" wx:if="{{order.description}}">
      <text class="info-label">{{t['orderDetail.notesLabel']}}</text>
      <text class="info-value">{{order.description}}</text>
    </view>
  </view>

  <!-- Patient Info -->
  <view class="detail-section" wx:if="{{order.patient_name}}">
    <view class="section-title">{{t['companionOrderDetail.patientInfo']}}</view>
    <view class="info-row">
      <text class="info-label">{{t['companionOrderDetail.patientName']}}</text>
      <text class="info-value">{{order.patient_name}}</text>
    </view>
  </view>

  <!-- Status Timeline -->
  <view class="detail-section" wx:if="{{order.timeline && order.timeline.length > 0}}">
    <view class="section-title">{{t['orderDetail.orderProgress']}}</view>
    <view class="timeline">
      <view class="timeline-item {{index <= order.timelineIndex ? 'active' : ''}}" wx:for="{{order.timeline}}" wx:key="time">
        <view class="timeline-dot"></view>
        <view class="timeline-content">
          <text class="timeline-title">{{item.title}}</text>
          <text class="timeline-time">{{item.time}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Review Section (if reviewed) -->
  <view class="detail-section" wx:if="{{order.review}}">
    <view class="section-title">{{t['companionOrderDetail.patientReview']}}</view>
    <view class="review-card">
      <rating-stars value="{{order.review.rating}}" readonly="{{true}}" />
      <text class="review-content">{{order.review.content}}</text>
      <text class="review-author">— {{order.review.patient_name}}</text>
    </view>
  </view>

  <view class="review-pending-hint" wx:if="{{order.status === 'completed' && !order.review}}">
    <text class="pending-text">{{t['companionOrderDetail.waitPatientReview']}}</text>
  </view>

  <!-- Action Buttons -->
  <view class="action-bar">
    <!-- Created: accept + reject (if assigned to this companion) -->
    <block wx:if="{{order.status === 'created'}}">
      <button class="btn-primary" bindtap="onAccept">{{t['companionOrderDetail.accept']}}</button>
      <button class="btn-reject" wx:if="{{order.companion_id}}" bindtap="onReject">{{t['companionOrderDetail.reject']}}</button>
    </block>

    <!-- Accepted: request start + chat + cancel -->
    <block wx:if="{{order.status === 'accepted'}}">
      <button class="btn-primary" bindtap="onStart">{{t['companionOrderDetail.notifyStart']}}</button>
      <button class="btn-secondary" bindtap="onChat">{{t['companionOrderDetail.contactPatient']}}</button>
      <button class="btn-reject" bindtap="onCancelAccepted">{{t['companionOrderDetail.cancelOrder']}}</button>
    </block>

    <!-- In Progress: complete + chat -->
    <block wx:if="{{order.status === 'in_progress'}}">
      <button class="btn-primary" bindtap="onComplete">{{t['companionOrderDetail.complete']}}</button>
      <button class="btn-secondary" bindtap="onChat">{{t['companionOrderDetail.contactPatient']}}</button>
    </block>

    <!-- Completed: chat only -->
    <block wx:if="{{order.status === 'completed'}}">
      <button class="btn-secondary" bindtap="onChat">{{t['companionOrderDetail.contactPatient']}}</button>
    </block>
  </view>
</view>
