<loading-overlay wx:if="{{loading}}" />

<view class="page-container">
  <!-- F-04: 4-dimension star rating -->
  <view class="section">
    <view class="section-title">{{t['reviewWrite.serviceRating']}}</view>

    <view class="dimension-row">
      <text class="dimension-label">{{t['reviewWrite.dimPunctuality']}}</text>
      <rating-stars
        value="{{punctuality_rating}}"
        readonly="{{false}}"
        size="medium"
        bind:change="onPunctualityChange"
      />
      <text class="dimension-score">{{punctuality_rating + t['reviewWrite.scoreUnit']}}</text>
    </view>

    <view class="dimension-row">
      <text class="dimension-label">{{t['reviewWrite.dimProfessionalism']}}</text>
      <rating-stars
        value="{{professionalism_rating}}"
        readonly="{{false}}"
        size="medium"
        bind:change="onProfessionalismChange"
      />
      <text class="dimension-score">{{professionalism_rating + t['reviewWrite.scoreUnit']}}</text>
    </view>

    <view class="dimension-row">
      <text class="dimension-label">{{t['reviewWrite.dimCommunication']}}</text>
      <rating-stars
        value="{{communication_rating}}"
        readonly="{{false}}"
        size="medium"
        bind:change="onCommunicationChange"
      />
      <text class="dimension-score">{{communication_rating + t['reviewWrite.scoreUnit']}}</text>
    </view>

    <view class="dimension-row">
      <text class="dimension-label">{{t['reviewWrite.dimAttitude']}}</text>
      <rating-stars
        value="{{attitude_rating}}"
        readonly="{{false}}"
        size="medium"
        bind:change="onAttitudeChange"
      />
      <text class="dimension-score">{{attitude_rating + t['reviewWrite.scoreUnit']}}</text>
    </view>

    <view class="overall-rating">
      <text class="overall-label">{{t['reviewWrite.overall']}}</text>
      <text class="overall-value">{{overallRating + t['reviewWrite.scoreUnit']}}</text>
    </view>
  </view>

  <!-- Content Section -->
  <view class="section">
    <view class="section-title">{{t['reviewWrite.contentTitle']}}</view>
    <textarea
      class="review-textarea"
      placeholder="{{t['reviewWrite.contentPlaceholder']}}"
      value="{{content}}"
      bindinput="onInput"
      maxlength="500"
      auto-height="{{false}}"
    />
    <view class="char-count">
      <text>{{content.length}}/500</text>
    </view>
  </view>

  <!-- Submit Button -->
  <view class="submit-wrapper">
    <button
      class="btn-submit"
      bindtap="onSubmit"
      loading="{{loading}}"
      disabled="{{loading}}"
    >{{t['reviewWrite.submit']}}</button>
  </view>
</view>
