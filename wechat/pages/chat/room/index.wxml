<view class="chat-container">
  <!-- Message List -->
  <scroll-view
    class="message-list"
    scroll-y="{{true}}"
    scroll-into-view="{{scrollIntoView}}"
    scroll-with-animation="{{true}}"
    upper-threshold="60"
    bindscrolltoupper="onScrollToUpper"
    enable-back-to-top="{{true}}"
  >
    <view class="history-hint" wx:if="{{loadingMore}}">{{t['common.loading']}}</view>
    <view class="history-hint history-hint-end" wx:elif="{{historyExhausted && messages.length > 0}}">{{t['chat.historyEnd']}}</view>
    <view class="message-padding-top" wx:else></view>
    <view
      wx:for="{{messages}}"
      wx:key="id"
      id="msg-{{index}}"
    >
      <chat-bubble
        message="{{item}}"
        isMine="{{item.sender_id === currentUserId}}"
      />
    </view>
    <view class="message-padding-bottom"></view>
  </scroll-view>

  <!-- Quick Actions for pending orders (created = waiting for companion to accept) -->
  <view class="quick-actions" wx:if="{{orderStatus === 'created'}}">
    <button class="action-btn action-btn-outline" bindtap="onViewOrder">{{t['chat.viewOrderDetail']}}</button>
    <button class="action-btn action-btn-primary" bindtap="onAcceptOrder">{{t['chat.acceptOrder']}}</button>
  </view>

  <!-- Input Bar -->
  <view class="input-bar">
    <view class="input-wrapper">
      <input
        class="chat-input"
        placeholder="{{t['chat.inputPlaceholderShort']}}"
        value="{{inputValue}}"
        bindinput="onInput"
        bindconfirm="onSend"
        confirm-type="send"
        adjust-position="{{true}}"
        maxlength="4000"
      />
    </view>
    <button
      class="send-btn {{inputValue ? 'active' : ''}}"
      bindtap="onSend"
      disabled="{{!inputValue}}"
    >{{t['chat.send']}}</button>
  </view>
</view>
