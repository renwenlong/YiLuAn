<view class="role-select-page">
  <view class="page-header">
    <text class="title">{{t['role.selectTitle']}}</text>
    <text class="subtitle">{{t['role.selectSubtitle']}}</text>
  </view>

  <view class="role-cards">
    <view class="role-card" data-role="patient" bindtap="onSelectRole">
      <view class="role-icon patient-icon">
        <text class="icon-text">{{t['role.patientBadge']}}</text>
      </view>
      <text class="role-name">{{t['role.iamPatient']}}</text>
      <text class="role-desc">{{t['role.patientDesc']}}</text>
    </view>

    <view class="role-card" data-role="companion" bindtap="onSelectRole">
      <view class="role-icon companion-icon">
        <text class="icon-text">{{t['role.companionBadge']}}</text>
      </view>
      <text class="role-name">{{t['role.iamCompanion']}}</text>
      <text class="role-desc">{{t['role.companionDesc']}}</text>
    </view>
  </view>

  <view class="loading-mask" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
  </view>
</view>
