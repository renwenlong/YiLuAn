# ============================================================
# YiLuAn — staging 本地密钥覆盖（不入库！复制本文件为 env.staging.local）
# ============================================================
#
#   cp env.staging.local.example env.staging.local
#   # 然后填入真实值
#
# 启动时作为第二个 --env-file 叠加在 env.staging 之上，
# 同名变量【后加载者优先】，因此这里只写需要覆盖的真值，其余留给 env.staging。
#
#   docker compose --env-file env.staging --env-file env.staging.local \
#       --profile staging up -d --build
#
# up.sh / up.ps1 会自动检测 env.staging.local 是否存在并叠加，无需手动传。
# ------------------------------------------------------------
#
# 只列「需要用真值覆盖」的项。下面是最常见的两个（微信小程序真凭据）：

# 真实微信小程序 AppID（覆盖 env.staging 的空值）
WECHAT_APP_ID=wxxxxxxxxxxxxxxxxx

# 真实微信小程序 AppSecret
WECHAT_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------
# 可选：本地若想用更强的 JWT/admin 密钥而非 staging 假值，也可在此覆盖：
# JWT_SECRET_KEY=my-local-strong-secret
# ADMIN_API_TOKEN=my-local-admin-token
