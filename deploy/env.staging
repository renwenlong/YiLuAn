# ============================================================
# YiLuAn — staging 环境配置（入库，全部为假值/可公开值）
# ============================================================
# 真实密钥（如微信 AppSecret）不要写在这里。
# 在同目录建 env.staging.local（已被 .gitignore 忽略）覆盖假值，
# 启动时作为第二个 --env-file 叠加，后加载者优先。
# 格式见 env.staging.local.example。
# ============================================================

# ---------- 运行环境 ----------
# 保持 development：让演练脚本能用 dev-OTP 000000 确定性登录。
# 真正的生产闸门是 config.py 里的 environment == "production"。
ENVIRONMENT=development
DEBUG=true

# ---------- 数据库 ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=yiluan_staging

# pg/redis 仅绑本地高位口（避免与 dev 的 5432/6379 及 agent-squad 冲突）。
# staging 对外只经 nginx:18080，pg/redis 不需直连。
PG_HOST_BIND=127.0.0.1
PG_HOST_PORT=15432
REDIS_HOST_BIND=127.0.0.1
REDIS_HOST_PORT=16379

# WSL2 + Windows host 客户端 (微信小程序开发者工具 / Postman / 浏览器) 访问 staging stack:
# 需 nginx 绑 0.0.0.0 让 Win11 22H2+ WSL2 auto-localhost-forward 生效 (帝君 2026-06-08 拍 A 方案).
# 安全: WSL2 默认 firewall 隔离 Windows host 直接 access internet, 0.0.0.0 仅 Windows host + 内网可达.
# pg/redis 仍绑 127.0.0.1 (不暴露 db/cache), 仅 nginx 端点 ±外.
NGINX_HOST_BIND=0.0.0.0
NGINX_HOST_PORT=18080

# ---------- 密钥（staging 假值，可公开）----------
JWT_SECRET_KEY=staging-not-secret-not-for-prod
ADMIN_API_TOKEN=staging-admin-token

# S3-DEV-001 / ADR-0046 §3.2: Contract patient pseudonym salt（与 PII_HASH_SALT 独立）。
# ContractService.request_generation 在 settings.contract_pseudonym_salt 为空时哨兵抛错（accept_order 会 500），
# 故 staging 也必须显式设置。staging 入库假值（>= 32 char、≠ PII_HASH_SALT、≠ canary salt），
# 真生产环境必须在 env.production 用 `python -c "import secrets; print(secrets.token_urlsafe(64))"` 生成。
CONTRACT_PSEUDONYM_SALT=staging-contract-pseudonym-salt-DPLMIYfRc2Uu8bCjlKq53g

# ============================================================================
# S3-OPS-DEPLOY-PII-SECRETS-AUDIT (ADR-0029 §3 / 魈 PR #217 self-flag follow-up)
# ============================================================================
# PII_HASH_SALT 为 phone hash (HMAC-SHA256) 所用 salt；PII_ENVELOPE_KEY 为
# emergency PII / strong-PII 密文落库的 base64-32-byte AES-256 envelope key.
# config.py 默认是 dev 雷同值 → 任何不显式 override 的环境都 = dev
# (PIPL 反查暴露). PR #217 仅补了 CONTRACT_PSEUDONYM_SALT, 同款的
# PII_HASH_SALT / PII_ENVELOPE_KEY 仍需补 staging/canary/prod 三环境独立值.
#
# staging 入库假高熵 (>= 32 char, 互不雷同, 与 CONTRACT_PSEUDONYM_SALT 不同).
# 生产 env.production 必须重生: python -c "import secrets; print(secrets.token_urlsafe(64))" (hash salt)
#                                       python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())" (envelope key)
PII_HASH_SALT=staging-pii-hash-salt-35nh-1g8h7Y3A8EKPJmCPW3FSGGpUGgErQojnTJGyMo
PII_ENVELOPE_KEY=K6oJ1Ip+YtQFKZSVuMqSyvy9Snz9d5EAOWh9NpuQpz0=

# ---------- Provider（staging 走 mock）----------
PAYMENT_PROVIDER=mock
SMS_PROVIDER=mock
MOCK_PAY_BASE_URL=http://mock-pay-stub:8001
MOCK_SMS_BASE_URL=http://mock-sms-stub:8002
WECHAT_PAY_NOTIFY_URL=http://nginx/api/v1/payments/wechat/callback

# ---------- 微信小程序（假值占位，真值放 env.staging.local）----------
# 留空时 wx.login() 会走真 weixin.qq.com 拿 errcode=40013；
# 需要真 code 兑换时在 env.staging.local 填真实 AppID/Secret。
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ---------- 调度 / WS ----------
SCHEDULER_ENABLED=false
WS_PUBSUB_ENABLED=true

# ---------- S2-OPS-010 监控（Prometheus/Alertmanager/Grafana） ----------
# 企业微信群机器人 webhook URL，真值在 env.staging.local 注入，
# 留空 webhook 走 dry-run 模式（不发企业微信，只打日志，便于本地起栈调试）
WECHAT_WORK_WEBHOOK_URL=

# Grafana 管理员账号（首次启动后建议 env.staging.local 改密码）
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=staging-grafana-not-for-prod

# S3-BUG-003: AI blocklist startup strict load (yml missing → backend startup FAIL).
# 运维环境必开避免 silent fail-open 让 ADR-0048 关键词过滤在 prod 默默失效.
AI_BLOCKLIST_STRICT_LOAD=true
