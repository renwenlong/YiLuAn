# ============================================================
# YiLuAn — dev 本地开发环境配置模板
# ============================================================
# 用法：
#   cp env.dev.example env.dev
#   ./up.sh dev
#
# dev profile 起【轻量本地后端】：pg + redis + backend-dev
#   * backend-dev 直接暴露 8000，热挂载 ../backend/app（改代码即生效）
#   * pg 暴露 5432、redis 暴露 6379 到宿主 → 本地直接跑 pytest（连 localhost）
#   * 不起 nginx / mock-pay / mock-sms / seed —— 那些是 staging 的活
#
# 替代被删的 backend/docker-compose.yaml（dev 栈），dev 现在是单骨架一等公民。
# ============================================================

# ---------- 运行环境 ----------
ENVIRONMENT=development
DEBUG=true

# ---------- 数据库 ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=yiluan

# dev 暴露 pg/redis 到宿主，方便本地 pytest 直连
# 注意：默认避开 agent-squad 占用的 5432/6379/8000，改用 5433/6380/8001。
# 本地 pytest 的 DATABASE_URL/REDIS_URL 需对应指向这些端口。
PG_HOST_BIND=127.0.0.1
PG_HOST_PORT=5433
REDIS_HOST_BIND=127.0.0.1
REDIS_HOST_PORT=6380

# backend-dev 暴露到宿主
BACKEND_HOST_BIND=127.0.0.1
BACKEND_HOST_PORT=8001

# ---------- 密钥（dev 本地假值）----------
JWT_SECRET_KEY=dev-not-secret
ADMIN_API_TOKEN=dev-admin-token

# S3-DEV-001 / ADR-0046 §3.2: Contract patient pseudonym salt.
# ContractService.request_generation 哨兵会空串报 ContractPseudonymSaltMissingError，
# accept_order 路径会 500 —— dev 本地走同样哨兵，所以也设假值。
# 必须与 PII_HASH_SALT 不同。
CONTRACT_PSEUDONYM_SALT=dev-contract-pseudonym-salt-do-not-use-in-prod

# ============================================================================
# S3-OPS-DEPLOY-PII-SECRETS-AUDIT (ADR-0029 §3 / 魈 PR #217 self-flag follow-up)
# ============================================================================
# dev 默认仅供本地开发，不走 prod 哨兵；config.py 已在同名默认值上加
# fail-fast guard — 生产环境 (APP_ENV=production) 使用以下 dev 值会启动报错.
# 本地跨 agent / 多 session 如果需要 phone hash 跨 worktree 一致，允许独立 dev
# 覆盖值 (不伤生产).
PII_HASH_SALT=dev-pii-hash-salt-do-not-use-in-prod
PII_ENVELOPE_KEY=eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHg=

# ---------- Provider（dev 走 mock，进程内 MockProvider，不起 stub 容器）----------
PAYMENT_PROVIDER=mock
SMS_PROVIDER=mock

# ---------- 调度 / WS ----------
SCHEDULER_ENABLED=false
WS_PUBSUB_ENABLED=true

# S3-BUG-003: AI blocklist startup strict load. dev 默认 false 不阻本地启动.
AI_BLOCKLIST_STRICT_LOAD=false
