# ============================================================
# YiLuAn — dev 本地开发环境配置模板
# ============================================================
# 用法：
#   cd deploy/dev
#   cp env.dev.example env.dev
#   docker compose --env-file env.dev -p yiluan-dev up -d   # 起 db + redis
#   # 后端在 backend/ 下用 uvicorn 裸跑（热重载），见 README 方式一
#
# dev 栈只起 db + redis 两个容器；后端用 uvicorn 直接跑（不进容器，改代码即生效）。
# db/redis 暴露宿主 5433/6380（避开 agent-squad 的 5432/6379），本地后端与 pytest 直连这两个口。
# nginx / mock-pay / mock-sms / seed 都是 staging 的活，dev 不起。
# ============================================================

# ---------- 数据库（仅供 db 容器初始化用）----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=***
POSTGRES_DB=yiluan

# ============================================================
# 本地后端（uvicorn 裸跑）连接串参考 —— 写进 backend 的本地 .env：
#   DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/yiluan
#   REDIS_URL=redis://127.0.0.1:6380/0
#   ENVIRONMENT=development
#   DEBUG=true
#   JWT_SECRET_KEY=***
#   ADMIN_API_TOKEN=***
#   PAYMENT_PROVIDER=mock
#   SMS_PROVIDER=mock
#   SCHEDULER_ENABLED=false
# ============================================================
