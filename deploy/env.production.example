# ============================================================
# YiLuAn — production 环境配置模板（入库为 .example；真值文件 env.production 不入库）
# ============================================================
#
#   cp env.production.example env.production   # 然后填入真实值
#
# ⚠️ 生产部署前必须逐项确认，所有敏感值不得留默认/假值。
# 注意：当前 docker-compose.yml 的 name/端口写死为 staging（帝君决策 ④：先不参数化）。
#       正式上 production 时需配套把 name/ports 参数化或另开 compose override。
# ============================================================

# ---------- 运行环境 ----------
ENVIRONMENT=production
DEBUG=false

# ---------- 数据库 ----------
POSTGRES_USER=yiluan_prod
POSTGRES_PASSWORD=__CHANGE_ME__strong_db_password
POSTGRES_DB=yiluan

# pg/redis 端口绑定（生产建议不对宿主暴露，仅内网达）。
# 若需调试可临时改为 127.0.0.1；默认绑本地高位口。
PG_HOST_BIND=127.0.0.1
PG_HOST_PORT=15432
REDIS_HOST_BIND=127.0.0.1
REDIS_HOST_PORT=16379

# ---------- 密钥（必须随机强密钥）----------
# 生成：python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=__CHANGE_ME__
ADMIN_API_TOKEN=__CHANGE_ME__

# S3-DEV-001 / ADR-0046 §3.2: Contract patient pseudonym salt (与 PII_HASH_SALT 独立、与 cert image salt 独立).
# ❗️ service_contracts.patient_pseudonym = SHA-256(name||last4||CONTRACT_PSEUDONYM_SALT) 是长期存储 +
# WORM (7y) 不可 retroactive rotate → 在 prod 首次曝光前必须一次性定下高熵随机串，
# 之后任何 rotate 都要按 ops runbook (docs/ops/canary-deployment.md §2.4) 走双写 + retroactive 背填。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(64))"
CONTRACT_PSEUDONYM_SALT=__CHANGE_ME__contract_pseudonym_salt_distinct_from_PII_HASH_SALT__

# ============================================================================
# S3-OPS-DEPLOY-PII-SECRETS-AUDIT (ADR-0029 §3 / 魈 PR #217 self-flag follow-up)
# ============================================================================
# PII_HASH_SALT — phone hash (HMAC-SHA256) salt. WORM 语义与 CONTRACT_PSEUDONYM_SALT
# 一致: phone_hash 是 users/companion_profiles 反查键, 不可 retroactive rotate.
# 生产首次部署前必须入库高熵 + 与 CONTRACT_PSEUDONYM_SALT / JWT_SECRET_KEY 不同.
# 生成：python -c "import secrets; print(secrets.token_urlsafe(64))"
# rotate 请走 docs/ops/canary-deployment.md §2.4 PII_HASH_SALT rotate runbook.
PII_HASH_SALT=__CHANGE_ME__pii_hash_salt_distinct_from_CONTRACT_PSEUDONYM_SALT__

# PII_ENVELOPE_KEY — base64-32-byte AES-256 envelope key for emergency PII 加密落库
# (ADR-0029). 生产必须从 KMS / Secret Manager 注入；P1 默认是 Vault
# (如未上 Vault 可先用高熵 base64-32-byte 随机值过渡, 但 ops runbook 记档).
# 生成：python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# rotate 需走 EnvelopeKey.rotate() 双写 + 重加密历史 ciphertext (不是完全 WORM, 但上万条同步 batch).
PII_ENVELOPE_KEY=__CHANGE_ME__base64_32_byte_AES_256_envelope_key__

# ---------- Provider（生产走真实）----------
PAYMENT_PROVIDER=wechat
SMS_PROVIDER=aliyun
# 生产不挂 mock stub（不激活 staging profile），以下留空
MOCK_PAY_BASE_URL=
MOCK_SMS_BASE_URL=
WECHAT_PAY_NOTIFY_URL=https://your-domain/api/v1/payments/wechat/callback

# ---------- 微信小程序 ----------
WECHAT_APP_ID=__CHANGE_ME__
WECHAT_APP_SECRET=__CHANGE_ME__

# ---------- 调度 / WS ----------
SCHEDULER_ENABLED=true
WS_PUBSUB_ENABLED=true

# S3-BUG-003: AI blocklist startup strict load (yml missing → backend startup FAIL).
# Production 必开.
AI_BLOCKLIST_STRICT_LOAD=true
