# =============================================================================
# YiLuAn canary 灰度通道环境变量（S2-OPS-011 + 帝君 04:00 UTC 拍 E+B 路径）
# -----------------------------------------------------------------------------
# 与 env.staging 叠加使用（compose --env-file env.staging --env-file env.canary）。
# 本文件入库，仅含假值 / 可公开值。真密钥放 env.canary.local（gitignore）。
# 完整部署文档：docs/ops/canary-deployment.md
#
# **帝君 04:00 UTC 拍 E+B 路径**（魈 + 刻晴推荐）：
#   - Phase 1（本文件默认）：mock-pay-stub 先跑 §1 资金线大头，**不卡物料**
#   - Phase 2（env.canary.local 覆盖）：ngrok + 真签名 wxpay 补 §1.1 一条核心链路
# =============================================================================

# ---------- E+B Phase 1: mock-pay-stub（不卡物料 可立即跑）----------
# canary 环境走 mock provider，复用 staging 已起的 mock-pay-stub / mock-sms-stub。
# Phase 2 切到真 wxpay 时由 env.canary.local 覆盖 PAYMENT_PROVIDER=wechat 等。
PAYMENT_PROVIDER=mock
SMS_PROVIDER=mock
MOCK_PAY_BASE_URL=http://mock-pay-stub:8001
MOCK_SMS_BASE_URL=http://mock-sms-stub:8002

# Phase 1 不需要公网回调（mock-pay-stub 内部网络调 backend callback，
# 见 S2-BUG-W001 修复 fire-and-forget 触发 mock-pay-stub /__trigger-callback）。
# Phase 2 覆盖为 https://<ngrok-domain>/api/v1/payments/wechat/callback
WECHAT_PAY_NOTIFY_URL=http://nginx/api/v1/payments/wechat/callback

# 灰度开关 —— 默认全开，回滚时由 runbook 热切
# 详 docs/ops/canary-rollback-runbook.md
FEATURE_SHARE_F2_ENABLED=true
READONLY_SHARE_SESSIONS=false

# canary 按 staging-like 语义启动；不启用本地万能 OTP / 微信登录 bypass。
ENVIRONMENT=staging
DEBUG=false

# canary 数据库（与 staging 隔离，避免 staging 测试数据污染真支付链路）
POSTGRES_DB=yiluan_canary

# ---------- S2-OPS-013 错开 host port 避撞 staging ----------
# staging 占用 15432 / 16379 / 18080 / 9090 / 9093 / 13000
# canary 错开高 10：1xxxx → 2xxxx；高 1：9090 → 9091；13000 → 13001
PG_HOST_BIND=127.0.0.1
PG_HOST_PORT=25432
REDIS_HOST_BIND=127.0.0.1
REDIS_HOST_PORT=26379
# WSL2 + Windows host 客户端 访问 canary stack (同 staging 启动 帝君 2026-06-08 A 方案).
# pg/redis/prom/am/grafana 仍绑 127.0.0.1, 仅 nginx ±外.
NGINX_HOST_BIND=0.0.0.0
NGINX_HOST_PORT=18090
PROM_HOST_BIND=127.0.0.1
PROM_HOST_PORT=9091
AM_HOST_BIND=127.0.0.1
AM_HOST_PORT=9094
GRAFANA_HOST_BIND=127.0.0.1
GRAFANA_HOST_PORT=13001

# 企业微信告警群机器人 —— Phase 1 留空（本地 dry-run 不发企微）
# Phase 2 在 env.canary.local 填真 webhook URL
WECHAT_WORK_WEBHOOK_URL=

# S3-DEV-001 / ADR-0046 §3.2: Contract patient pseudonym salt。
# canary 走 mock 链路但 ContractService 哨兵仍走 → 必须显式设置。
# Canary salt 与 env.staging 不同 (避免 staging fixture 污染 canary contract hash)。
# 真生产另走 env.production，请用 secrets.token_urlsafe(64) 重生。
CONTRACT_PSEUDONYM_SALT=canary-contract-pseudonym-salt-BD8rVFPYppnaA3FCDyOECg

# ============================================================================
# S3-OPS-DEPLOY-PII-SECRETS-AUDIT (ADR-0029 §3 / 魈 PR #217 self-flag follow-up)
# ============================================================================
# canary 走 mock 链路但 ADR-0029 PII 加密哨兵仍走 → 必须独立值与 dev/staging 隔离.
# canary salt 与 staging/prod 不同 (避 staging fixture 污染 canary phone hash, 避
# cross-env replay attack vector). 真生产另走 env.production, 请重生.
PII_HASH_SALT=canary-pii-hash-salt-uqKQ-HniYhqq3sjlO1r4nO2oICrHXDh7k6eOkXxxYTY
PII_ENVELOPE_KEY=1na9KDvqGH61Lgp/zJgBMUub2ZRj1PZG0T1IaLIxm0Q=

# =============================================================================
# Phase 2 覆盖指南（env.canary.local 加这些覆盖 Phase 1）：
# =============================================================================
#
#   # 切到真 wxpay
#   PAYMENT_PROVIDER=wechat
#   SMS_PROVIDER=aliyun
#
#   # ngrok 隧道 → backend callback
#   WECHAT_PAY_NOTIFY_URL=https://<your-ngrok-subdomain>.ngrok.io/api/v1/payments/wechat/callback
#
#   # 微信支付沙箱号（帝君申请）
#   WECHAT_PAY_APP_ID=wxXXXXXXXX
#   WECHAT_PAY_MCH_ID=XXXXXXXX
#   WECHAT_PAY_API_V3_KEY=***
#   WECHAT_PAY_CERT_SERIAL=***
#
#   # 阿里云 SMS（帝君 AccessKey）
#   ALIYUN_SMS_ACCESS_KEY_ID=LTAI5XXXXXXX
#   ALIYUN_SMS_ACCESS_KEY_SECRET=***
#   ALIYUN_SMS_SIGN_NAME=医路安
#   ALIYUN_SMS_TEMPLATE_CODE=SMS_XXXXXXXXX
#
#   # 企业微信测试群机器人 webhook（帝君拉群）
#   WECHAT_WORK_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=***

# S3-BUG-003: AI blocklist startup strict load (yml missing → backend startup FAIL).
AI_BLOCKLIST_STRICT_LOAD=true
